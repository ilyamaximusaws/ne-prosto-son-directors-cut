            $ nd_d6_icansafe = True

            show us surp2 sport at cright with dspr

            window show
            us "Конечно, надо их уговорить."
            "Произнесла пионерка, со сцены показывая рукой на всех пионеров, находившихся в помещении."
            show us normal sport at cright with dspr
            us "Мы не оставим их, так ведь?"
            nd_il "Мне бы очень хотелось взять всех с собой."
            "Подтвердил я, положительно кивнув головой."
            nd_il "Мы выведем их отсюда."
            show us surp2 sport at cright with dspr
            nd_il "Но энергии струны во мне не хватит на всех..."
            us "Какой струны?"
            "Воззрилась на меня пионерка удивленным взглядом."
            nd_il "Потом расскажу."
            hide us with dspr
            "Отрезал я, сопроводив свою реплику поворотом на девяносто градусов - к отряду."
            window hide

            $ renpy.pause(1, hard=True)
            show mt normal pioneer far at center with dspr
            $ renpy.pause(0.5, hard=True)
            show dv normal pioneer far at fleft
            show mi normal pioneer far at left
            with dspr
            $ renpy.pause(0.5, hard=True)
            show un normal pioneer far at fright
            show sl normal pioneer far at cright
            with dspr

            window show
            "Только стоило мне поднести микрофон ко рту, все пионеры тут же обратили на меня свой чересчур заинтересованный взор, пугающий до мурашек."
            "Я уже был готов произнести свои первые слова, но надо было заранее прокрутить в голове все доводы, выстроить свою речь так, чтобы мне смогли довериться."
            "В планах уже на этот момент было: рассказать всё как есть на самом деле, рассказать про сон, про Пророка..."
            window hide

            $ renpy.pause(1, hard=True)

            window show
            "Я сделал глубокий вдох прямо в микрофон, почему-то не уловивший моего прерывистого ветра."
            play music ndm_list['nd_something_ok'] fadein 4
            nd_il "Сегодня мне приснился сон в музыкальном клубе."
            nd_il "На пристани стоял человек, который говорил мне, что весь мир ждет своего упадка."
            show sl surprise pioneer far at cright with dspr
            show mi scared pioneer far at left with dspr
            nd_il "В связи с этим, я не знаю, останетесь ли вы целы."
            "После этих слов Славя с Машей перепуганно переглянулись друг с другом, но я проигнорировал это их действие."
            show dv scared pioneer far at fleft with dspr
            "Алиса Двачевская вслед за вышеупомянутыми девочками упала в нешуточное замешательство."
            nd_il "Он говорил только за Ульяну, что ей необходимо уйти со мной."
            show un shocked pioneer far at fright with dspr
            "За этими словами проснулась и Лена, лицом показывая, как сильно она готова выпасть в осадок."
            nd_il "Я понимаю, это прозвучит как полный бред, как и все что я сказал до этого, но есть множество миров."
            nd_il "И переместившись в этот мир по одной из струн, я выбросил много энергии в него."
            nd_il "Я боюсь, что вы можете не дожить до конца этого дня, и поэтому очень хочу, чтобы вы пошли со мной."
            window hide

            $ renpy.pause(1, hard=True)
            show un shy pioneer far at fright with dspr
            $ renpy.pause(1, hard=True)

            window show
            un "Мне тоже часто снятся вещие сны про этот лагерь."
            "Раскрыв свои веки от удивления, я обогнул взглядом сказавшую это предложение Лену."
            $ nd_d6_gw_un = True
            un "И мне кажется, Илья говорит правду. Я пойду с ним."
            $ nd_d6_gw_sl = True
            show sl shy pioneer far at cright with dspr 
            sl "Лена, раз такое дело, я иду с вами. Я тоже верю Илье."
            show sl normal pioneer far at cright with dspr
            sl "У меня тоже бывают вещие сны иногда, и после рассказа Ильи..."
            window hide

            $ renpy.pause(2, hard=True)

            window show
            sl "Я уже не уверена, что тут можно оставаться."
            "После недолгого безмолвия Славяна завершила свою реплику, передав слово следующим пионерам."
            window hide

            hide sl
            hide mt
            hide dv
            hide un
            hide mi
            with dspr
            $ renpy.pause(1, hard=True)
            show sh normal pioneer far at left with dspr
            show el normal pioneer far at right with dspr

            window show
            sh "Это всё антинаучно, не могут сны быть вещими!"
            "Вызвался на спор голос Шурика с другого конца спортзала."
            el "Это правда, сны генерирует сознание человека, а не какая-то там сила."
            "Подтвердил за своим коллегой Электроник слегка язвительным тоном, от которого меня чуть не стошнило."
            el "А то что вы сейчас приводите как факты - просто ваш личный опыт и череда совпадений."
            window hide

            $ renpy.pause(0.5, hard=True)

            $ nd_scept_old = nd_scept
            $ nd_stoic_old = nd_stoic

            menu:
                "Зацепиться за сомнение (Очки скептицизма)":
                    
                    window show

                    if nd_scept >= 3:
                        nd_il "Знаете, я на самом тоже не совсем понимаю, что делать дальше."
                        nd_il "Но другого выхода сейчас нет. Мы выйдем к дороге, и будем стараться добраться до ближайшего населенного пункта пешком."
                        nd_il "Если повезет, нас подберет какой-нибудь автобус."
                        nd_il "Самое главное - мы будем в порядке."
                        "По лицу одного из кибернетиков было видно, что он не на шутку задумался над моими словами."
                        "Второй же, я был на сто процентов уверен, примет сторону своего коллеги."
                        window hide

                        $ renpy.pause(1, hard=True)
                        show el grin pioneer far at right with dspr
                        
                        window show
                        el "А знаешь, попытка не пытка, в конце концов не с ходячими мертвецами идем сражаться..."
                        "Усмехнувшись проговорил Электроник, но в усмешке этой не было и намека на какую-то надежду."
                        sh "Раз идёт Эл, то пойду и я."
                        $ nd_d6_gw_sh = True
                        $ nd_d6_gw_el = True
                        hide sh
                        hide el
                        with dspr
                        "По итогу советские ученые всё же согласились присоединиться к тандему уходящих из лагеря людей."
                    
                    else:
                        "Я попытался встать на сторону кибернетиков."
                        nd_il "Знаете, я на самом тоже не совсем понимаю, что делать дальше."
                        nd_il "Но другого выхода сейчас нет. Мы выйдем к дороге, и будем стараться добраться до ближайшего населенного пункта пешком."
                        show el serious pioneer far at right with dspr
                        el "Есть выход - остаться здесь до прихода помощи. они знают, что мы здесь сидим, и они приедут или прилетят в конце концов."
                        "Долго спорить с ними я не стал, да и результатов бы это никаких не дало, судя по тому, как яро они защищали свою позицию"
                        "Теперь мне оставалось уговорить остальных - кого смогу."
                    
                    window hide

                "Убедить (Очки стоицизма)":
                    
                    window show

                    if nd_stoic >= 4:
                        "Я принял решение убедить кибернетиков."
                        "Мы обменивались фактами \"за\" и \"против\" на протяжении десяти минут, пока..."
                        show el grin pioneer far at right with dspr 
                        el "Знаешь, я думаю, что пойду с вами."
                        el "В перспективе, я хотел бы быть дома уже завтра, твой довод со временем мне понравился."
                        el "Можно сказать, ты победил в споре."
                        sh "Раз идёт Эл, то пойду и я."
                        $ nd_d6_gw_sh = True
                        $ nd_d6_gw_el = True
                        hide sh
                        hide el
                        with dspr
                        "По итогу советские ученые всё-же согласились присоединиться к тандему уходящих из лагеря."

                    else:
                        "Я попытался убедить кибернетиков в своей правоте, но они напрочь отказывались мне верить."
                        "Чтобы я не сказал им, они всегда оставались верны своей идеологии о том, что это всё полнейший бред"
                        "Решив их не донимать, я оставил их в покое, не стараясь дальше что-то им противопоставлять."
                    
                    window hide

            $ renpy.pause(1, hard=True)
            show mi smile pioneer far at center with dspr
            $ renpy.pause(1, hard=True)

            window show
            mi "Я пойду с вами."
            "Немногословно сказала Мику, наблюдая за кибернетиками и их действиями."
            "Не знаю, почему она смотрела в данный момент именно на кибернетиков."
            "Кажется, у неё на уме сейчас было что-то своё, отдаленное от нас и нашего спора."
            "Проще говоря, опять чьи-то мотивы за гранью моего понимания."
            window hide

            hide mi with dspr
            $ renpy.pause(1, hard=True)
            show mt normal pioneer far at center with dspr
            show mz normal pioneer far at left with dspr
            show dv normal pioneer far at right with dspr
            $ renpy.pause(1, hard=True)

            window show
            "По итогу из всех, кого необходимо уговаривать, остались только Женя, Ольга Дмитриевна и Алиса."
            hide dv with dspr
            "Последняя, видя Ульяну на моей стороне, без каких либо раздумий вступила на её сторону, а значит и на мою тоже."
            "Вторая осмотрелась на тех, кто идет со мной, а потом, подняв на меня взгляд, спросила:"
            mt "Илья, ты уверен, что это хорошая идея?"
            "Говорила она абсолютно спокойно, без намека на агрессию."
            mt "После того отряда должен был приехать наш автобус."
            mt "Может он стоит сейчас на стоянке и сигналит, ожидая всех пионеров."
            "Мне показалось, в головах тех пионеров, что были на моей стороне, заиграло смутное сомнение насчет правильности выбранного пути."
            "Признаться, такое же заиграло и у меня, но я быстро вспомнил, что у нас с рыжей девочкой иной путь."
            window hide

            $ renpy.pause(1, hard=True)

            window show
            nd_il "Мы сможем заодно проверить стоянку."
            nd_il "Оттуда тоже можно выйти в лес, или даже пройти по дороге."
            nd_il "Я не продумывал эту часть плана, всё ещё многое зависит от обстоятельств..."
            window hide

            $ renpy.pause(1, hard=True)

            window show
            "Дав Ольге Дмитриевне подумать, я сам не понял, как она перешла на мою сторону."
            "Но Женя...{w} Ей, судя по её плачевному виду, было совсем плохо, чтобы принимать решение."
            "Она изредка подавала здоровые признаки жизни, но всё ещё должна была говорить."
            th "Контакт с метеоритом, упавшим на футбольное поле, сделал её такой..."
            "Констатировал про себя я."
            window hide

            hide mz with dspr
            hide mt with dspr

            $ renpy.pause(1, hard=True)

            window show
            if nd_d6_gw_sh == False:
                nd_il "Женя, мы не можем тебя оставить тут с кибернетиками."
            else:
                nd_il "Женя, мы не можем тебя оставить тут одну."
            "Обратился я к девушке, явно намекая на то, что ей необходимо уходить вместе с нами."
            show mz laugh pioneer far at center with dspr
            mz "Я не хочу никуда уходить."
            mz "Я чувствую, что со мной что-то не так."
            mz "Что я теряю свой рассудок."
            "Проговаривала девушка, иногда посмеиваясь в голосе, однако поводов для радости не было."
            "Видно, что она делала это неизмождённо."
            nd_il "Всё будет нормально, Жень."
            show mz normal pioneer far at center with dspr
            mz "Боюсь, что нет."
            "Вернула она себе адекватный такой привычный её менталитету вид."
            if nd_d6_gw_sh == False:
                nd_il "Если мы оставим кибернетикам медикаменты, они смогут присмотреть за тобой."
                sh "Мы, наверное, пойдем на стоянку, и там будем ждать."
                sh "Женя, тебе нужно с нами."
            window hide

            hide mz with dspr

            stop music fadeout 5

            $ renpy.pause(3, hard=True)

            window show
            "Женя сделала пару шагов к нам навстречу."
            show mz normal pioneer at center with dspr
            mz "Даже если я пойду с вами, мне не хочется быть ношей для вас."
            nd_il "Ты не станешь нам ношей, если пойдешь с нами."
            nd_il "Согласна?"
            mz "Да..."
            "Отдаленно мыслями, но она согласилась уходить вместе со всеми, и это уж точно не могло не радовать."
            nd_il "Тогда давайте будем выходить на улицу. Судя по обстановке на улице..."
            hide mz with dspr
            "Я взглянул на темные окна, из-за которых едва просачивался лунный свет."
            nd_il "Стоит держаться за руки, чтобы не потеряться в темноте..."
            window hide

            $ renpy.pause(1, hard=True)
            scene black with dissolve
            play sound sfx_open_door_clubs
            $ renpy.pause(3, hard=True)

            window show
            "Пионеры молча выходили на улицу парами, один за другим."
            window hide

            $ renpy.pause(1, hard=True)
            scene bg int_hallway_sporthall_night with dissolve
            $ renpy.pause(0.5, hard=True)

            window show
            "Минуя коридор невольно задумываешься, что тебя может ждать дальше."
            "Может, вместе дождя там град? Или что-то хуже?"
            "Однако, ни дождя ни града слышно не было. Лишь обычные ночные звуки. Или не совсем?"
            "Мне казалось, в них был отблеск какого-то ужаса, будто сама природа была напугана тем, что происходит с ней."
            window hide

            stop music fadeout 3
            stop ambience fadeout 3
            stop back_ambience fadeout 3
            stop sound_loop fadeout 3
            stop sound fadeout 3

            scene black with dissolve2

            $ renpy.pause(3, hard=True)

            $ renpy.music.set_volume(1.0, delay=0, channel="ambience")

            jump nd_d6_end_with_all

        "Они в безопасности":
            $ nd_d6_allok = True

            show us normal sport at cright with dspr

            window show
            us "Я думаю, раз он за остальных ничего не сказал, то с ними все должно быть в порядке."
            "Сказала девушка, пытаясь меня приободрить."
            us "Хотелось бы только Алису с собой взять..."
            show us sad sport at cright with dspr
            us "Я так не хочу с ней расставаться.{w} Но ничего не поделаешь."
            show us shy sport at cright with dspr
            us "Эх-х-х..."
            "Тяжело выдохнув, Ульяна отвела свой взгляд в сторону."
            window hide

            $ renpy.pause(1, hard=True)

            window show
            nd_il "Энергии струны во мне может не хватить на всех..."
            show us surp2 sport at cright with dspr
            us "Какой струны?"
            "Воззрилась на меня пионерка удивленным взглядом."
            nd_il "Потом объясню."
            show us normal sport at cright with dspr
            "Отрезал я, повернувшись к остальному отряду."
            window hide 

            hide us with dspr
            $ renpy.pause(1, hard=True)

            play music ndm_list['nd_something_ok'] fadein 4

            window show
            "Только стоило мне поднести микрофон ко рту, все пионеры тут же обратили на меня свой взор."
            "Я уже был готов говорить, но мне нужно было ещё раз прокрутить свою прощальную речь в голове."
            "Думаю, то же самое необходимо было сделать и Ульяне.{w} Ей ведь точно есть, с кем попрощаться, учитывая, что она провела дольше времени в этом лагере чем я."
            window hide

            $ renpy.pause(1, hard=True)

            window show
            nd_il "Ладно...{w} Если вы не собираетесь уходить, я думаю, нам с Ульяной необходимо с вами попрощаться."
            dv "Ульяна, ты уходишь?!"
            "Прокричала Алиса, но ответа от Ули, на моё удивление, не последовало."
            nd_il "С её позволения, сначала это сделаю я..."
            window hide

            $ renpy.pause(1, hard=True)

            window show
            "Видимо, Ульяна оказалась не против, раз ответила на мои слова тем же молчанием."
            nd_il "Вы для меня все очень дороги, и мне жаль, что всё так происходит."
            nd_il "Я надеюсь, что вы обретёте своё счастье, рано или поздно."
            nd_il "Вы все прекрасны по своему.{w} Вы все позволили мне раскрыться с определенной стороны."
            nd_il "Особенно Алиса, желаю хорошего чилла."
            "Видимо, никто в зале мною сказанного не понял, но Алиса улыбнулась, помахав то ли мне, то ли Ульяне."
            nd_il "Спасибо вам ещё раз за всё.{w} Слово Ульяне."
            "Сказав это, я протянул Ульяне микрофон."
            show us normal sport at right with dspr
            us "Алиса, ты лучшая подруга. Мне очень жаль, что мне приходится уходить."
            show us sad sport at right with dspr
            us "Ты знаешь, где я живу, поэтому пиши письма на мой адрес и не забывай."
            show us cry sport at right with dspr
            us "Мне нравился этот отряд, и мне тоже очень сложно расставаться, как и Илье."
            "Я услышал, как голос Ульяны сломался под давлением слёз."
            "Повернувшись к ней я увидел, как та воротом вытирала капельки со своих глаз..."
            window hide

            $ renpy.pause(1, hard=True)
            hide us with dspr
            $ renpy.pause(1, hard=True)

            window show
            "Девочка перечислила каждого в зале и рассказала, о том, что она думает."
            "Так Алиса оказалась лучшей подругой, а кибернетики просто смешными ботаниками."
            "Они даже хотели что-то возразить, но на тот момент Ульяна уже переключилась на Славю."
            "Кстати о Славяне, Ульяна очень добро о ней отозвалась, назвав подругой, и пожелав счастья."
            "Лену она поблагодарила за то, что та ранее помогла ей с футбольным кружком, только я не понял, как и при каких обстоятельствах это произошло."
            "С Женей она тоже попрощалась, но сама библиотекарша не смогла ничего выдавить кроме \"Мне тоже жаль, что всё так быстро проходит\"."
            "Ольгу Дмитриевну Ульяна уверила, что с ней всё будет в порядке и я о ней позабочусь. Вожатая в ответ лишь положительно качнула головой."
            window hide

            stop music fadeout 4
            show black with dissolve 
            $ renpy.pause(2, hard=True)
            play sound sfx_open_door_clubs
            $ renpy.pause(1, hard=True)
            scene bg int_hallway_sporthall_night with dissolve2

            window show
            "У выхода из здания мы с Ульяной ещё раз попрощались со всеми пионерами."
            "В случае с Ульяной не обошлось без слёз, но я всеми силами постарался её успокоить."
            "И в коридоре на выходе мы тоже очень долго прощались."
            mt "Спасибо за концерт."
            nd_il "Пожалуйста, Ольга Дмитриевна."
            sl "Мы будем по вам скучать."
            dv "Подруга, не забывай."
            "Произнесла Алиса, передавая Ульяне её рюкзачок."
            us "Никого не забуду!"
            window hide

            stop music fadeout 3
            stop ambience fadeout 3
            stop back_ambience fadeout 3
            stop sound_loop fadeout 3
