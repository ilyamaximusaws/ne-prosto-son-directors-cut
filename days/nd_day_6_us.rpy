#---------------------------------------------------------------------------
# Не спойлери себе игру! 
#---------------------------------------------------------------------------

#---------------------------------------------------------------------------
init:
# Переменные сценария
    $ nd_d6_allok = False
    $ nd_d6_icansafe = False

    $ nd_us_goodpoints = 0
    $ nd_us_badpoints = 0

    $ nd_d6_checkkitchen = False

    $ nd_d6_gw_dv = False
    $ nd_d6_gw_un = False
    $ nd_d6_gw_mt = False
    $ nd_d6_gw_mz = False
    $ nd_d6_gw_sh = False
    $ nd_d6_gw_el = False
    $ nd_d6_gw_sl = False
#---------------------------------------------------------------------------


label nd_day_6_start:

    play ambience nda_list['rain_outside'] fadein 3
    
    scene black
    show day_6_nd:
        xalign 0.5 yalign 0.5 zoom 1.5 alpha 0.0
        ease 2.0 zoom 1.0 alpha 1.0
    with dissolve2
    $ renpy.pause(5, hard=True)
    play music ndm_list['sleep_sharing']
    hide day_6_nd
    $ nd_mouse_parallax.set((-60, -15, "l0"), (-45, -5, "l0"))
    $ nd_showp("day_6_blur_nd", "day_6_text_nd")
    with flash
    # show day_6_blur_nd with dissolve2
    
    $ renpy.pause(15)
    stop ambience fadeout 3
    stop music fadeout 3
    $ nd_hidep("day_6_blur_nd")
    $ nd_hidep("day_6_text_nd")
    with flash
    $ renpy.pause(2, hard=True)
    $ nd_scenep()

    $ nd_change_time('prolog')

    if nd_stoic >> nd_scept:
        $ new_chapter(4, u"Это не просто сон, верно?\nДень шестой | Ульяна\nФилософия: Стоицизм")
    if nd_scept >> nd_stoic:
        $ new_chapter(4, u"Это не просто сон, верно?\nДень шестой | Ульяна\nФилософия: Скептицизм")
    if nd_stoic == nd_scept:
        $ new_chapter(4, u"Это не просто сон, верно?\nДень шестой | Ульяна")

    $ renpy.pause(2, hard=True)

    play ambience nds_list['nd_sfx_veter'] fadein 4

    $ renpy.pause(2, hard=True)

    play music ndm_list['nd_db_moonlight'] fadein 4

    window show
    "А ты знаешь, что такое любовь?"
    "Любовь - чувство пленительное для твоего сознания.{w} Чувство удовлетворения. Такое сладостное, манящее."
    "Такое громкое слово, такое беспощадное... Не правда ли?"
    "Готов ли ты что-то изменить, дабы превратить твою бессмысленную привязанность в неё?"
    "Что ты готов принести в жертву, дабы вновь почувствовать на своих губах вкус этого забытого плода?"
    window hide

    $ renpy.pause(1, hard=True)

    show anim prolog_2 with dissolve2

    window show
    nd_whoer "Не молчи, скажи мне то, что у тебя сейчас на уме."
    nd_whoer "Пусть это станет твоей последней мыслью перед тем мгновением, когда ты вновь окунешься в то пространство, которое скучает по тебе."
    nd_whoer "Сон... Такой дорогой для тебя..."
    nd_whoer "Ты проснешься, когда тебе станет лучше."
    nd_whoer "Когда появится одна вселенная и исчезнет другая."
    nd_whoer "Та вселенная, где ты вновь не просто песчинка этого бренного мира."
    nd_whoer "Где ты нужен лишь одной. Той, которая останется с тобой даже после твоих многочисленных провалов."
    nd_whoer "Провалов, которые тебе не простит ни одна такая же..."
    window hide

    $ renpy.pause(2, hard=True)

    window show
    nd_whoer "Вселенная, где ты можешь больше, чем существовать."
    nd_whoer "Где ты - знак того, что все функционирует нормально."
    nd_whoer "Где ты не часть механизма. Напротив."
    nd_whoer "Ты - то, на чем держится этот механизм."
    nd_whoer "Сможешь ли ты спасти этот механизм от своего неизбежного выхода из строя?"
    nd_il "Я не знаю."
    "Проглотив, произнёс я."
    nd_il "Но как?"
    nd_whoer "Ты можешь больше, чем думаешь."
    nd_whoer "Сила, которая у тебя в руках, сможет отправить тебя к малиновым восходам и красным закатам."
    nd_whoer "Тебе всего лишь нужно увидеть..."
    window hide

    $ renpy.pause(2, hard=True)

    show anim prolog_1 with dissolve2

    $ renpy.pause(1, hard=True)

    window show
    nd_il "Увидеть что?"
    nd_whoer"Четвёртое измерение."
    nd_whoer"Когда ты находишься в нём, ты одновременно существуешь, но и одновременно мёртв."
    nd_whoer"Как будто тебя лишили разума, либо он находится за пределами твоего понимания..."
    "Эти слова теряли свой смысл с каждой секундой, когда я погружался в них."
    "Более того, я сам терялся в том пространстве, в котором эти слова слышал."
    "Я не мог ощущать себя."
    "Да, я мог говорить, но это стоило мне больших усилий."
    "И только сейчас понимаешь, каких."
    "Только сейчас начинаешь понимать, что беседуешь с чем-то отдаленным. Не с самим собой."
    "Будто со сверчком у себя в голове."
    "Сверчком, у которого огромная власть. Который посадил тебя в это бесконечное пространство для переговоров."
    th "Что он хочет? Какая у него цель?"
    th "Он правда хочет помочь мне?"
    nd_whoer "Это загадка для нас обоих..."
    "Будто парировал мои мысли этот странный голос."
    nd_whoer "...Но какая..."
    nd_whoer "Ответ на неё будет стоить нещадно много."
    nd_whoer "Но мы с тобой, бок о бок, сможем её разгадать."
    window hide

    stop music fadeout 3
    $ renpy.pause(1, hard=True)

    window show
    nd_il "Василий?!"
    window hide

    stop ambience fadeout 2
    $ renpy.pause(0.5, hard=True)
    show black with dspr

    if persistent.nd_cursor_style == "normal":
        $ config.mouse_displayable = MouseDisplayable(notdream_UIpath + 'cur/normal/normal_cursor_prologue_v2.png', 0, 0)
    else:
        $ config.mouse_displayable = MouseDisplayable(notdream_UIpath + 'cur/circle/circle_cursor_prologue_v2.png', 30, 30)
    $ night_time()

    play ambience nda_list['nd_rain_vn'] fadein 3
    play sound nds_list['thunder']
    show black with flash
    $ renpy.pause(0.5, hard=True)

    window show
    usp "А-ай-ай-ай!"
    "Проникли вопли Ульяны в мой сон, тут же выкинув из него словно по команде."

    $ volume (1.0, "sound")
    scene bg int_house_of_gg_day_rain
    hide blink
    show unblink

    "Моментом разомкнув веки, я принялся оглядываться по сторонам."
    "По окну с наружней стороны стекали массивные капли дождя. Будто за лагерем были слышны внушительные раскаты грома."
    "Внутри этого домика было темно, свет совсем не проникал из окна в комнатку, из-за чего та казалась серой."
    "Достаточно серой для домика в летнем лагере отдыха."
    nd_il "Что случилось?"
    "Оклемавшись после внезапного пробуждения, выдавил я из себя чуть хриплым голосом."
    show us sad pioneer far at center with dspr
    us "Мне страшно."
    us "Я боюсь."
    "Произносила пионерка, делая внушительные паузы между словами, только этим подтверждая их."
    nd_il "Грома?"
    "Попросил уточнить я коротким вопросом."
    us "Нет."
    window hide

    hide us with dspr
    show us sad pioneer at center with dspr

    window show
    us "Кто-то очень сильно стучал. Я даже дверь пыталась запереть, чтобы не вошли."
    window hide

    hide us with dspr
    $ renpy.pause(1, hard=True)

    window show
    "Перекинув свой сонный взгляд на дверь, я шире раскрыл глаза, затем устремил взор на ручку, в спешке подпёртую шваброй."
    "Её наличие в моем домике достаточно удивляло, ведь свое внимание на неё я не обращал ровно до этого дня и до этого момента."
    "Возможно, она была спрятана где-то в шкафчике, который я изучил только раз за всю смену."
    "Тем не менее сейчас внутри меня был посеян страх, в первую очередь за жизнь Ульяны."
    "Я боялся, что это мог быть пионер, хоть он и говорил, что уйдёт из моей жизни."
    window hide

    $ renpy.pause(1, hard=True)

    window show
    nd_il "Он не вошел?"
    "С заметной дрожью вырвалось у меня из глотки."
    window hide

    $ renpy.pause(0.5, hard=True)

    show us sad pioneer at center with dspr

    window show
    us "Нет."
    us "Он ломился."
    us "Я пыталась тебя разбудить, а ты ни в какую..."
    us "Думала что ты уже не проснешься, плакала..."
    hide us with dspr
    "После её слов, мягко сказать, мне стало не по себе, будто на грудь наступили."
    "По погоде на улице было ясно лишь одно - настоящий кошмар только начинается."
    "Ульяна смотрела на меня так, будто ждала какой-то реакции, итак написанной у меня на лице,{w} а может и действий."
    "Но что я мог сделать с этим всем в данный момент?"
    "Надеяться только на себя опасно, вожатая проверяет домики обычно часов в десять-одиннадцать."
    "На часах же было только девять - завтрак только миновал."
    th "А был ли он вообще?"
    "Спросил я самого себя и продолжил размышления."
    th "Может все пионеры сейчас сидят по домикам?"
    nd_il "Ты не знаешь, где все остальные?"
    window hide

    play sound nds_list['nd_thunder']
    $ renpy.pause(2, hard=True)

    show us sad pioneer at center with dspr

    window show
    us "Откуда мне знать?"
    us "Всё время тут сидела. Думала выйти... Пока в окно не постучали."
    hide us with dspr
    "В один момент ко мне пришло озарение."
    "Может быть в домик хотела войти Даша?"
    "Она говорила вчера, что узнает о том, что случилось с лагерем."
    "Но не стала же она специально пугать и без того напуганную всем происходящим девочку?"
    window hide

    $ renpy.pause(2, hard=True)

    window show
    th "Анализ ситуации не помешает."
    th "Мы с Ульяной сейчас сидим в этом темном домике совсем одни, не знающие, что со всем этим делать."
    th "Выходить на улицу опасно."
    th "Тем более я не знал природу дождя, который лил, к слову, как из ведра, то и дело обрушиваясь на крышу новыми волнами."
    th "Даже для меня это было страшно, не говоря уже о девушках этого лагеря и даже об Ольге Дмитриевне."
    th "Если они ещё живы..."
    window hide

    $ renpy.pause(1, hard=True)

    window show
    "Эти мысли стали следствием мурашек на моей спине, и, слегка вздрогнув, я заключил:"
    nd_il "Нам нужно выбираться из домика."
    nd_il "Да, это может быть опасно."
    nd_il "Но встретить остальных необходимо, а также узнать в конце концов, всё ли с ними в порядке."
    show us sad pioneer at center with dspr
    us "Давай подождём."
    us "Может стучавший в окно ещё не ушёл..."
    window hide

    $ renpy.pause(2, hard=True)
    
    hide us with dspr

    window show
    "Её напуганный беззащитный голос отозвался внутри меня гулким эхом."
    "Я встал с кровати, подошёл к Ульяне и крепко обнял, положив руки ей на спину."
    "Та лишь смущенно ойкнула вслед моему действию."
    nd_il "Ты права. Мы не можем точно знать, только строить догадки."
    nd_il "Но для твоего блага, наверное, нам лучше остаться здесь, пока за нами никто не придёт."
    nd_il "Сам не в восторге от всего происходящего, если честно. В какой-то степени сам боюсь, но не отчаиваюсь."
    nd_il "В моей жизни тоже много чего случалось, но я всеми силами выкарабкивался из передряг."
    nd_il "Получалось тогда - получится и сейчас."
    window hide

    $ renpy.pause(0.5, hard=True)
    $ volume (0.1, "sound")
    play sound nds_list['nd_thunder']

    $ renpy.pause(0.5, hard=True)

    window show
    us "Спасибо."
    us "За то что успокоил, и за вчерашний вечер, что позволил остаться в твоём домике..."
    us "Я знала, что ты меня поймешь."
    nd_il "Ты права, я не мог поступить по другому."
    nd_il "Чувство внутри меня не позволило бы."
    window hide

    $ renpy.pause(1, hard=True)
    
    $ volume (1.0, "sound")

    window show
    "Я разжал наши объятия и посмотрел на Ульяну, подняв правую бровь."
    nd_il "А почему должно было быть иначе?"
    show us normal pioneer at center with dspr
    us "Ты мог сказать, что для моей безопасности лучше оставить меня с Алисой."
    nd_il "Ну, я ведь так не сказал, правильно?"
    show us shy2 pioneer at center with dspr
    us "Правильно..."
    "Вторила мне девушка, тяжело выдохнув."
    show us shy pioneer at center with dspr
    us "Поэтому я и говорю тебе это сейчас..."
    window hide

    hide us with dspr

    $ renpy.pause(2, hard=True)

    window show
    "Мы сели с Ульяной на противоположные кровати перед столом."
    "Девушка сначала посмотрела на окно, потом на меня и тепло улыбнулась."
    show us smile pioneer at center with dspr
    us "Расскажи, что снилось?"
    nd_il "Мне?"
    hide us with dspr
    "С явным удивлением в голосе произнёс я, в то же время заметив, как этим утром совсем не размышлял над недавно увиденным сновидением."
    "Мысленно я был благодарен Ульяне за напоминание, но и понимание того, что мысли о нём загонят меня ещё дальше не оставляло."
    show us smile pioneer at center with dspr
    us "Да, а я тебе расскажу, что снилось мне."
    "Ответила моя собеседница, когда я уже решился прочистить горло для своего рассказа."
    nd_il "Хорошо, начну..."
    window hide

    $ renpy.pause(1, hard=True)

    hide us with dspr

    window show
    "Ульяна выглядела максимально заинтересованной. Естественно, ведь она и задала мне свой вопрос."
    "Жажда получить ответ в её глазах прослеживалась не так сильно, как ожидалось, но всё равно это позволяло мне собрать мысли в порядок и высказать их."
    window hide

    $ renpy.pause(2, hard=True)

    show prologue_dream with dissolve2
    play music music_list['trapped_in_dreams'] fadein 4

    window show
    nd_il "Мне снился...{w} Монолог.{w} То ли с самим собой, то ли с кем-то другим."
    nd_il "Сопровождалось это размышлениями от самого простого до наиболее сложного."
    nd_il "Про какую-то силу, которую, как я понял, мне надо в себе открыть."
    nd_il "В конце голос сказал мне: \"Тебе всего лишь нужно увидеть четвёртое измерение\"."
    nd_il "Потом про загадку, которую нам с ним предстоит разгадать."
    nd_il "Да и, похоже, это всё."
    nd_il "Он сам,{w} его голос,{w} его размышления - всё это мне очень напомнило Василия."
    nd_il "Не пионера конечно, другого. Которого я встретил в другом сне."
    nd_il "Он говорил, что встретит меня в этом лагере, если что-то пойдёт не так."
    nd_il "И это, похоже, действительно был он."
    window hide

    hide prologue_dream with dissolve2

    $ renpy.pause(2.5, hard=True)

    show us grin pioneer at center with dspr

    window show
    us "Скукотища."
    "Сказала Ульяна так, будто чего-то подобного и ждала от моего рассказа."
    nd_il "Соглашусь, но очень интересная в изучении скукотища."
    nd_il "Четвёртое измерение... Параллельная реальность?"
    us "А мне снились котята. Огро-о-омные и пушистые!"
    "Карты сложились на свои места..."
    us "Как я одного кормила кукурузными палочками."
    show us surp2 pioneer at center with dspr
    "...Ей просто хотелось похвастаться своим сновидением."
    us "А потом, представляешь..."
    nd_il "Что потом?"
    us "Потом прилетел ещё один, с вот такущими крыльями!"
    us "Он был прям как настоящий!"
    us "Я села на него, а он как взлетит в небо..."
    show us surp1 pioneer at center with dspr
    us "Помню как трогала облака! Мягкие и пушистые... Как вата, но только ещё мягче!"
    us "Представляешь?"
    nd_il "Ага..."
    "Я был очень рад за Ульяну. Что она вновь возвращает себе свою жизнерадостность."
    "И я был очень рад за её сон."
    "Уверен, это Даша смогла сделать сон Ульяны таковым."
    "И за это ей огромное спасибо."
    "Она действительно лучшая сестра..."
    show us normal pioneer at center with dspr
    us "...А после я проснулась."
    window hide
    
    stop music fadeout 4

    $ renpy.pause(1, hard=True)

    window show
    nd_il "Жалко."
    nd_il "Вот бы нам устроить обмен снами...{nw}"
    show us shy pioneer at center with dspr
    us "Ты лежал и обнимал меня."
    window hide

    $ renpy.pause(1, hard=True)

    window show
    "Не успев усмехнуться после перебитой ею шутки, я упал в её взгляд."
    "Это то, чего я уж точно не ожидал от неё услышать, тем более сейчас, хотя и отчетливо помнил, что мы правда обнимались."
    "Зачем напоминать? Чтобы я смог ещё раз прочувствовать тот момент? Чтобы ощутил мурашки на своей спине?"
    th "Пожалуй..."
    us "Так нежно, что я взяла тебя за руку..."
    show us shy2 pioneer at center with dspr
    us "В домике было ещё темно и холодно, а ладонь твоя тёплая. И под одеялом с тобой тоже тепло..."
    us "Я не удержалась, обняла тебя, дурака..."
    us "А ты через сон мне улыбнулся."
    hide us with dspr
    "Я представил, как Ульяна зарывается в одеяло."
    "Как её лицо вновь предстает перед моим."
    "Как её влюбленный взгляд гипнотизирует меня."
    "Как наше теплое дыхание касается друг друга также, как и наши губы."
    "И всё-таки, не позволив себе зайти ещё дальше, я беру за шиворот своё сознание и кидаю в бездну размышлений."
    show us shy2 pioneer at center with dspr
    us "Я поцеловала тебя и уснула."
    "Ульяна отвела от меня взгляд, дабы скрыть своё смущение."
    "Признаться, я был смущён не меньше."
    hide us with dspr
    "От её слов."
    "От нежности того, что она и как она говорила."
    "От той магии в её словах, которая заставляла склониться меня перед пучиной времени и её образом, который может только сниться."
    "Я обещал себе: никогда я не вернусь назад, в тот серпентарий, где в роли ядовитых змей выступало время, навсегда замиравшее, только я облокачивался на спинку своего кресла."
