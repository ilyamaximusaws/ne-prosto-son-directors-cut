#---------------------------------------------------------------------------
# Не спойлери себе игру! 
#---------------------------------------------------------------------------

label notdream_dream_d2_d3:


    $ new_chapter(2, u"Это не просто сон, верно?\nСон: Незнакомец")
    $ persistent.sprite_time = 'night'
    
    if persistent.nd_cursor_style == "normal":
        $ config.mouse = {'default' : [(notdream_UIpath + 'cur/normal/normal_cursor_prologue.png', 0, 0)]}
    else:
        $ config.mouse = {'default' : [(notdream_UIpath + 'cur/circle/circle_cursor_prologue.png', 15, 15)]}
    
    $ prolog_time()


    play music ndm_list['us_dreaming'] fadein 3
    
    $ renpy.pause(1)
    
    window show
    psih "...И что было дальше?"
    nd_il "Потом я побежал в лес, на память к тому месту из сна."
    "..."
    psih "Там протекало чистое и прозрачное озеро, говорите?"
    nd_il "Да, именно так."
    window hide

    $ renpy.pause(1)
    
    window show
    psih "Хорошо.{w} Возможно, вы чувствуете какую-то привязанность к этой девушке, которую вы никак не можете объяснить?"
    nd_il "Не знаю. Не могу ответить на этот вопрос однозначно."
    nd_il "То, что я решил пойти на её поиски это достаточно странно для моего менталитета.{w} Я обычно редко помогаю кому-то. Даже не помню, когда последний раз это было."
    nd_il "Наверное, я хотел как-то отблагодарить её за маленькую экскурсию по лагерю в первом дне моего появления в нём, а может за её доверие ко мне."
    window hide

    $ renpy.pause(1)

    window show
    nd_il "...Ещё мне кажется, что у неё есть какая-то тайна с этим местом."
    nd_il "К сожалению, я не могу больше ничего вспомнить."
    window hide

    $ renpy.pause(1)
    
    window show
    psih "Той информации, которую вы предоставили, будет достаточно."
    psih "Из ваших снов следует то, что вы хотите осуществить какие-то ваши желания, которые не осуществимы в реальной жизни."
    psih "У вас есть что-то подобное? И, возможно с нашей прошлой встречи вы узнали о своей травме?"
    nd_il "Я совсем не помню своего прошлого, а насчет желаний даже не знаю."
    nd_il "От жизни я всегда хотел спокойствия и умиротворения. Я хотел бескрайнего простора для отдыха..."
    "Тот же самый разговор с психологом,{w} всё та же загадочная травма,{w} всё тот же сон."
    "Он говорит всегда об одном, чтобы не случилось. Всегда спокоен, никогда не показывает ни злости ни раздражения. Не было чувства, будто он отыгрывает роль."
    "Будто он поистине является спокойным человеком."
    window hide

    $ renpy.pause(1)

    window show
    psih "Хорошо.{w} Я выпишу вам список препаратов, которые должны помочь вам всё вспомнить..."
    "Психотерапевт достал бумажку, начиркал в ней несколько строк и любезно протянул её мне."
    "Мне почему-то казалось, что бумажка на самом деле пустая. Но как только я фокусировал на ней взгляд, строки магическим образом появлялись на белом клочке бумаги."
    window hide

    menu:
        
        "Взять бумажку":
            
            window show
            "Я взял эту до странности таинственную бумажку, и положил её к себе в карман."
            window hide

            $ renpy.pause(1)
            
            window show
            psih "Позвоните, если вам станет лучше."
            nd_il "Спасибо."
            window hide
            
            $ renpy.pause(1)
            scene bg int_school_ext_nd 
            show int_school_night
            with dissolve2
            play sound sfx_steps_clubs_nextroom

            window show
            "Попрощавшись с психотерапевтом и выйдя из кабинета, я спустился по лестнице на первый этаж и вышел на улицу."
            window hide

        "Не брать":

            $ paper_m = True
            window show
            psih "Позвоните, если вам станет лучше."
            nd_il "Конечно."
            window hide

            $ renpy.pause(1)
            scene bg int_school_ext_nd 
            show int_school_night
            with dissolve2

            play sound sfx_steps_clubs_nextroom

            window show
            "Выходя из больницы, я скомкал бумажку и выбросил её в мусорную урну рядом с дверьми..."
            "Сегодняшнее общение с психотерапевтом оказалось достаточно нудным и противным. Он не сказал мне ничего нового. И это меня раздражало сейчас больше всего."
            th "Никогда больше не свяжусь с ним."
            window hide

    show black with dissolve
    stop sound fadeout 3
    stop music fadeout 3
    $ renpy.pause(1)
    play ambience nda_list['light_rain_inside'] fadein 3
    scene bg city_night_rain with dissolve2
    play music ndm_list['RF_ushome'] fadein 3
    
    window show
    "С неба обильно капали мелкие дождевые капли."
    "Надев капюшон, я направился к ближайшей остановке, чтобы сесть в автобус и доехать до дома."
    "На улице было довольно холодно, и моя куртка едва могла спасти меня от холода."
    "Всё вокруг будто напоминало тот самый вечер, после которого я попал в лагерь \"Совёнок\". Всё кроме дождя. Правильнее было бы заменить его на снег. Но это не имело значения сейчас."
    window hide

    $ renpy.pause(1)
    
    window show
    "Я шёл и думал о своем времяпровождении в лагере, о словах психолога о своей какой-то давней травме..."
    "И я даже не представлял, о чем идет речь. И возможно, это просто какая-то шутка."
    "Очередная попытка навязать мне что-то, пользуясь моим положением, как это обычно бывает, но в этом случае ещё и моей амнезией."
    window hide

    if paper_m == False:
        window show
        "Хотя возможно, эти препараты, которые мне выписал психотерапевт в бумажке, действительно должны мне помочь?"
        window hide

    if paper_m == True:
        window show
        "Хотя возможно, эти препараты, которые мне выписал психотерапевт в бумажке, действительно должны были мне помочь?"
        window hide

    $ renpy.pause(3)
    
    window show 
    "Но мои размышления прервал какой-то парень, вышедший из-за угла многоэтажного дома."
    stop music fadeout 3

    "Видимо, гопник. Или просто мужик, собирающий на очередную бутылку водки."
    stranger "Эй, братан, закурить не найдётся?"
    th "Классика."
    "Я залез в карман куртки, и вытащив зажигалку протянул её незнакомцу.{w} Сам я не курил, и наличие зажигалки в моей куртке мне самому было не до конца понятно."
    stranger "От души, выручил."
    "Лица его я разглядеть не смог, он был одет в лёгкую куртку с капюшоном, и в светлые джинсы."
    
    show vsc rf at center with dspr 
    
    "Он зажёг сигарету и, закурив, отдал мне мою зажигалку."
    "Я думал, на этом эта личность закончит наш диалог и отправится восвояси, но он продолжил:"
    stranger "Я знаю о твоих похождениях в лагере."
    window hide

    $ renpy.pause(1)

    window show
    "Я пал в ступор. Я не знал даже, что и говорить. В голове было много вопросов."
    nd_il "Но как ты узнал? И кто ты вообще?"
    stranger "Можешь звать меня Василием. А ты - Илья, если я не ошибаюсь."
    "Василий снова закурил сигарету и, выпустив очередной клуб дыма, посмотрел на меня."
    stranger "Ну, чего молчишь?"
    vst "Тебе та девушка понравилась, если не ошибаюсь, и вероятно ты хочешь знать, что она скрывает от тебя."
    window hide

    $ renpy.pause(1)

    window show
    th "Она от меня что-то скрывает?"
    nd_il "Ну, да…"

    if nir >= 3:
        vst "Тогда слушай, всё в этом лагере имеет смысл." 
        vst "Все твои выборы имеют значение.{w} B то, в какую сторону ты идёшь..."
        vst "И если бы ты сделал по другому, наш разговор был бы немного другим."
        vst "Твое поведение в лагере достаточно странное, я не знаю чего ты добиваешься, но ничего ты этим не добьёшься."
        vst "Конечно, если ты не видел чего-то большего, чем стены твоей тесной комнаты."

    elif d2_dv_night_pristan == False:

        vst "Тогда слушай, всё в этом лагере имеет смысл." 
        vst "Все твои выборы имеют значение.{w} И то, что ты начал её искать, это тоже один из путей.{w} Можно сказать, если бы ты её не нашёл мы бы сейчас не разговаривали."
    
    elif d2_dv_night_pristan == True:
        
        vst "Тогда слушай, всё в этом лагере имеет смысл."
        vst "Все твои выборы имеют значение.{w} Можно сказать, если бы ты не встретился с ней на пристани, мы бы сейчас не разговаривали."
    window hide

    $ renpy.pause(1)

    window show
    vst "Я понаблюдаю за тобой, и если дела пойдут совсем хреново, я встречу тебя в лагере."
    vst "Это может случиться через день, через три, а может и никогда."
    vst "Но что-то мне подсказывает, что это случится."
    vst "И случится очень скоро."

    "Договорил Василий и, в последний раз затянув сигарету, выкинул бычок и придавил своим кроссовком."        
    nd_il "Понятно, но что мне тогда делать?"
    vst "Это уже тебе решать, братан."
    vst "Главное помни, мои слова."
    window hide

    hide vsc rf with dspr
    $ renpy.pause(1)

    window show
    "Василий сплюнул, и медленно пошёл куда-то, а я продолжил путь до остановки."
    th "Откуда он столько обо мне знает?{w} Как он меня встретит?{w} Кто это вообще?"
    window hide

    $ renpy.pause(1)

    window show
    dvp "Стойте, подождите!"
    "Позади послышался приближающийся женский голос..."
    window hide

    $ renpy.pause(2)
    
    window show
    "Я повернулся и увидел женщину, которая мне кого-то напоминала."
    "У неё были рыжие волосы, темное пальто и фиолетовый зонт..."
    window hide

    $ renpy.pause(2, hard=True)
    show dv smile coat at center with dspr
    
    window show
    "Она подбежала ко мне, и разглядев внимательнее её лицо, я узнал Алису из \"Совёнка\"."
    dvp "Вы телефон потеряли."
    "Сказала девушка и вытащила из кармана пальто мой смартфон."
    nd_il "Спасибо большое."
    window hide

    $ renpy.pause(1, hard=True)
    
    window show
    nd_il "Вам не кажется, что мы уже где-то виделись?"
    dvp "Не знаю, мы вроде бы не знакомы, но я вас, кажется, знаю.{w} Вас Илья зовут?"
    nd_il "Да, а вас Алиса, если не ошибаюсь."
    dvp "Так и есть. Вы на четыреста десятый?"
    nd_il "Наверное..."
    dvp "Тогда нам по пути."
    "Алиса слегка улыбнулась, и мы отправились к остановке."
    window hide

    hide dv smile coat with dspr
    show black with dissolve
    
    window show
    th "Странно, что Алису не удивил тот факт, что мы знакомы, хоть и не знакомились никогда.{w} Только в лагере."
    th "Хотя, может это знак того, что сейчас я тоже в лагере?"
    th "Да нет, бред какой-то."
    window hide

    scene bg city_toronto_rain with dissolve2
    $ renpy.pause(1)
    play sound sfx_intro_bus_engine_start
    $ renpy.pause(5)
    play sound_loop sfx_bus_idle
    
    window show
    "Дойдя до остановки, к нам сразу же подъехал четыреста десятый автобус."
    dvp "Вот этот наш..."
    "Cказала Алиса и, взяв меня за рукав, потащила в автобус." 
    window hide

    scene bg prolog_bus_inside with dissolve
    $ renpy.pause(1)
    play sound sfx_bus_out

    window show
    "Мы сели на два последних места."
    window hide

    $ renpy.pause(2)
    
    window show
    nd_il "Можно я у окна сяду?"
    dv "Садись."
    window hide
    show intro_xx_rain with dissolve2
    
    $ renpy.pause(1)
    
    window show
    th "Надо бы расслабиться."
    stop sound_loop fadeout 4
    "Я достал из кармана наушники, и вставив штекер в разъем телефона включил первый попавшийся трек."    
    play music ndm_list['promise_silent_hill_cover'] fadein 4
    window hide

    $ renpy.pause(2)

    window show
    th "Может мы действительно встретимся с ним в лагере..."
    window hide

    $ renpy.pause(2)

    stop music fadeout 3
    stop ambience fadeout 3
    stop sound_loop fadeout 3
    show blink

    window show
    "Смотря в окно на протяжении пяти минут, я медленно закрыл глаза и почувствовал приближающийся сон..."
    window hide
    
    $ renpy.pause(2, hard = True)

    jump d3_start_without



    