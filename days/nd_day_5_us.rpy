screen nd_thunder_backentrancet_screen:

    imagemap:
        ground "mods/notdream/images/extra/nd_thunder_backentrancet.png"
        hover "mods/notdream/images/extra/nd_thunder_backentrancet.png"
        alpha True

        hotspot (1078, 0, 221, 185) action (Jump("nd_show_video_thunder"))

label nd_show_video_thunder:

    hide screen nd_voicebar_screen

    stop ambience fadeout 2
    hide screen nd_thunder_backentrancet_screen

    stop music
    show black
    play movie "mods/notdream/images/bg/dv_r/nd_epicthunder.ogv" loop
    show movie

    $ renpy.pause(10, hard=True)

    hide movie
    stop movie

    play ambience ambience_camp_entrance_night fadein 3
    scene bg nd_ext_backentrance_night
    show us cry pioneer far at center

    if persistent.thunder_nd == 0:
        $ persistent.thunder_nd = 1
        $ nd_completed_secrets += 1

    jump nd_end_thunder

label nd_day_5_start:

    play ambience ambience_forest_night fadein 4
    show day_5_nd with nd_effect_5
    $ renpy.pause(2, hard = True)
    show day_5_blur_nd with dissolve
    $ renpy.pause(1, hard = True)
    show day_5_text_nd with nd_effect_5_reverse
    $ renpy.pause(0.3, hard = True)
    hide day_5_text_nd with nd_effect_5_reverse
    $ renpy.pause(0.3, hard = True)
    show day_5_text_nd with nd_effect_5
    $ renpy.pause(0.3, hard = True)
    hide day_5_text_nd with nd_effect_5
    $ renpy.pause(0.3, hard = True)
    show day_5_text_nd with nd_effect_5_reverse
    $ renpy.pause(1, hard = True)
    stop ambience fadeout 4
    scene black with nd_effect_5_reverse

    $ nd_change_time('night')

    $ new_chapter(4, u"Это не просто сон, верно?\n День пятый | ???")

    if nepodhod_87 == True:
        jump nd_day_5_dream_pi
    else:
        jump nd_day_5_dream_us

label nd_day_5_dream_pi:

    $ renpy.pause(4, hard=True)

    play ambience ambience_camp_center_night fadein 3
    scene bg ext_square_night with dissolve2
    $ renpy.pause(1, hard=True)

    window show
    "Вновь перед глазами та самая площадь."
    "Я не знал, что я тут снова забыл."
    "Будто я оказался здесь просто из ниоткуда."
    "Я сидел на лавочке, не думая вставать с места.{w} Я лишь думал о чём-то отдалённом, глубоком. Но что-то в этой обстановке было не так."
    show pi smile at center with dspr
    pi "Ну что-ж, молодец!"
    th "Что за чертовщина? Как он оказался здесь?! Он же сказал, что его не будет."
    nd_il "Что ты тут забыл?"
    pi "Моя школа."
    "Проигнорировав мой вопрос перебил меня он."
    pi "Не поддержать того, кто тебя любит, и кого любишь ты - дорогого стоит."
    nd_il "В смысле?"
    th "Что он несёт?!"
    pi "Какой же ты...{w} Мерзкий..."
    "По его голосу было слышно, как он всеми фибрами своей души хвалил меня."
    nd_il "Да о чём ты?"
    pi "Ты думаешь, после того, что ты даже в трудную минуту её не поддержал, она примет тебя как товарища?"
    "Всё также игнорируя мои вопросы он продолжал тянуть свою речь."
    nd_il "Да, она же моя подруга."
    show pi normal at center with dspr
    pi "Хорошо, давай спросим у неё же, как она относится к твоему поступку."
    "Сказал пионер, приняв по настоящему серьёзное выражение лица."
    "И к моему удивлению, в тот же самый момент на площадь вышла Ульяна со стороны домиков."
    "И, заметив нас, она подошла ближе."
    show us normal pioneer at left with dspr
    us "Что у вас тут происходит, почему вы не спите?"
    show pi smile with dspr
    pi "Илья хотел у тебя спросить, любишь ли ты его."
    show us shy pioneer at left with dspr
    us "Его?"
    "Произнесла вопросительно-непонимающе она, а потом на выдохе продолжила."
    us "Не знаю..."
    us "Как я могу его любить если он..."
    "Ульяна потупила взгляд в пол."
    play music ndm_list["nd_deep_despair"] fadein 4
    show us shy2 pioneer at left with dspr
    us "Жалок..."
    "В один момент в груди защемило, а в ушах эхом отразились эти слова, перебегая по струнам моего мозга."
    nd_il "Ульяна, что ты такое говоришь?"
    hide us with dspr
    "Я перебросил взгляд на пионера."
    nd_il "{b}Что ты с ней сделал?!{/b}"
    pi "Просто спросил её отношение к тебе."
    pi "Что Илья, ты же этого добивался."
    th "Нет, это не правда..."
    show us shy pioneer at left with dspr
    us "Илья, я не люблю тебя."
    us "Ты из другого мира, и...{w} Просто трус."
    window hide

    hide us
    hide pi
    with dspr

    window show
    "В глазу началось дикое покалывание."
    "Мне хотелось верить в то, что она шутит, что сейчас она улыбнётся, но..."
    show us sad pioneer at center with dspr
    us "Ты подвел всех в этом лагере..."
    hide us with dspr
    "Я опустил голову вниз."
    nd_il "Зачем ты делаешь мне больно?"
    nd_il "Я просто хотел провести с тобой больше времени."
    "Я был кардинально сломан. Слова Ульяны... Я не верил что это она... Но удивляет, насколько она схожа в мнении со мной..."
    window hide

    $renpy.pause(2, hard=True)


    play sound_loop nds_list["nd_run_on_road"] fadein 3
    scene bg ext_houses_night:
        zoom 1.05
        anchor (48,27)
        ease 0.20 pos (0, 0)
        ease 0.20 pos (25,25)
        ease 0.20 pos (0, 0)
        ease 0.20 pos (-25,25)
        repeat
    with dissolve

    window show
    "Поняв, что я могу не выдержать, я подорвался с лавочки и побежал прочь с площади..."
    "Я хотел убежать подальше от того места, я хотел...{w} Я хотел уйти.{w} Только чтобы всё прекратилось, чтобы всем было лучше."
    "Но в голове промелькнула странная мысль: \"Почему Ульяна ведёт себя сейчас кардинально по другому?\"."
    "Не понимая, что я ей сделал, я выбегал в лес."
    window hide

    scene black with dissolve
    stop sound_loop fadeout 3

    window show
    "Я бежал всё дальше и дальше, но голос Ульяны отражался в моей памяти."
    window hide

    scene bg ext_path2_night with dissolve

    window show
    "Мне приспичило остановиться чтобы перевести дух."
    th "Я не могу останавливаться, нет...{w} Мне нужно...{w} Бежать..."
    window hide

    with vpunch
    play sound sfx_fall_grass

    $ renpy.pause(1, hard=True)

    stop ambience fadeout 4
    stop music fadeout 4

    show blink

    window show
    "Я упал на мягкую траву и закрыл глаза, из которых плавно стекали слёзы..."
    window hide

    $ renpy.pause(2, hard=True)

    play ambience ambience_int_cabin_night fadein 4
    play sound_loop sfx_head_heartbeat fadein 3
    play music ndm_list['RF_rm_1'] fadein 4
    scene bg int_house_of_gg_night_1 with flash

    window show
    "Я проснулся в своей кровати. Лоб был в испаренной."
    "В домике была глубокая ночь. До боли пугающая."
    "Она будто смотрела на меня из пустоты, поглощая своим взглядом."
    "Я понимал, что больше не смогу уснуть. Мне нужно было обдумать то, что я только что видел. Это был сон... Он не казался мне таковым..."
    stop sound_loop fadeout 4
    "Будто я только что испытал весь спектр эмоций, что скрывался во мне эти пять последних дней."
    "Я не понимал, к чему он."
    th "Это могло быть пророчеством, что что-то должно случиться или уже случилось."
    th "Что за мной сейчас кто-то наблюдает прямо из моего окна, окутанного мраком."
    th "Кто знает, как выглядят эти смотрящие, о которых мне рассказала Даша в катакомбах.{w} Может это мутанты, пугающие силуэты, или просто пустота."
    th "Может за мной следят прямо сейчас?"
    "В страхе я зашторил окно, и настоятельно пытался вдолбить себе в голову, что это закончится."
    "Но я не мог. Все мысли были только об одном - что я совершил ошибку."
    "Что я не до конца поговорил с Ульяной на площади. Что она не узнала о том, что я из далёкого будущего, что я... Обманул её?"
    "Я не мог себе простить многих вещей. Одна из них преследовала меня в недавно увиденном кошмаре."
    "Что я не часть этого мира, что я попросту никто здесь. Песчинка, пытающаяся сломать время, лишняя шестерня в большой часовне."
    "И для того, чтобы все были счастливы, мне остается только одно..."
    window hide

    show black with dissolve
    $ renpy.pause(1, hard=True)
    play sound nds_list['applysuit']
    $ renpy.pause(1, hard=True)
    hide black with dissolve

    window show
    "Одевшись в пионерскую форму, я поспешил в тот же миг выбраться на улицу..."
    window hide

    play sound sfx_open_door_1
    stop ambience fadeout 3
    show black with dissolve
    $ renpy.pause(2, hard=True)
    play ambience ambience_camp_center_night fadein 3
    scene bg ext_house_of_gg_night2 with dissolve
    play sound sfx_close_door_1

    window show
    "Моим большим страхом сейчас было увидеть Ульяну. Она бы сразу подбежала ко мне с вопросами, со своей заботой, которая способна убить во мне остатки рассудка."
    "И в тот момент, когда я бы начал объясняться перед ней, она бы сказала, что я нужен здесь как никто другой. Но это будет враньём, которое внушил ей я же..."
    "И я не хочу..."
    window hide

    $ renpy.pause(1, hard=True)
    scene black with dissolve2
    $ renpy.pause(1, hard=True)
    play sound_loop sfx_run_forest fadein 3
    $ renpy.pause(1, hard=True)

    scene bg ext_path2_night:
        zoom 1.05
        anchor (48,27)
        ease 0.20 pos (0, 0)
        ease 0.20 pos (25,25)
        ease 0.20 pos (0, 0)
        ease 0.20 pos (-25,25)
        repeat
    with dissolve2

    window show
    "Я бежал и бежал, и просто не мог остановиться."
    "Я боялся, что меня найдут утром в лесу, каким бы я ни был. Живым или мёртвым, или неспособным к связной речи."
    "Если бы кто-то смотрел на меня сейчас со стороны, он бы не понял, куда я бегу в такую ночь."
    th "И если я не вернусь,{w} пусть хоть она не увидит меня таким..."
    window hide

    stop sound_loop fadeout 5
    stop music fadeout 5
    show black with dissolve3
    $ renpy.pause(5, hard=True)
    play ambience ambience_int_cabin_night fadein 4
    play music ndm_list['us_dreaming'] fadein 3
    scene bg int_house_of_dv_night with dissolve2

    window show
    "Сон никак не хотел одолевать меня."
    "Я попросила Алису оставить светильник в домике включенным, но мне всё равно приснился этот кошмар, и я кричала на весь домик."
    "Я не знаю почему. Мне снилось, как Илья поцеловал меня, а потом как я не успела его спасти, и тот пионер убил его..."
    th "Почему я не поцеловала его на площади?"
    "Я посмотрела в сторону Алисы, которая обеспокоенно глядела в потолок."
    "Видимо, она была очень зла на то, что я её разбудила своим криком."
    th "Я была не уверена, что должна это делать."
    th "У меня была полная мешанина в голове из мыслей о многом. О нём, о том, что скажет вожатая, когда узнает что нас хотели убить."
    th "Я очень боялась, что Илья скажет что-то плохое мне, как это делают остальные."
    "Тот пионер пугал меня сейчас больше всего."
    th "Вдруг он придёт к Илье сегодня ночью? Он ему угрожал..."
    dv "Да всё будет нормально, Уля."
    dv "Если это из-за Ильи, то он вроде бы нормальный парень, правда не догоняет многое, но всё равно."
    dv "В твоём возрасте я бы такого не упускала."
    "Я взяла свою подушку и кинула её в свою рыжую подругу"
    us "Алиса, о чём ты таком говоришь? Я не уверена в том, что он мне нравится..."
    "Алиса метнула мне мою подушку обратно со словами."
    dv "Ага, восходы с ним смотришь, футбол играешь, за ручку ходишь..."
    us "Не было такого!"
    dv "Ты думаешь я не знаю?"
    "Протянув и с нажимом сказала она."
    dv "Если не знаешь, любишь ли его или нет, то посмотри на это с другой стороны."
    us "Мне нужно поговорить с ним об этом сегодня утром."
    us "Не знаю, решусь я или нет..."
    dv "Ничего не бойся, если он тебя тронет я клянусь, я сразу вломлю ему в..."
    us "Алиса!"
    dv "Ну чего сразу Алиса-то? Я же не сказала, что за просто так вломлю.{w} За дело же."
    us "Вот поэтому с тобой мальчики и не разговаривают.{w} Боятся."
    dv "Тут ты не права, Семён..."
    us "Так Семён же за Леной бегает..."
    dv "Да ты не знаешь, за кем он бегает."
    dv "Только за чужими отношениями и смотришь, а в своих разобраться не можешь."
    "Как только Алиса отвернулась, я ей в спину показала язык."
    window hide

    $ renpy.pause(1, hard=True)

    window show
    "Спустя минуту в размышлениях я прокручивала сцену с Ильёй утром, как только он проснётся."
    "Хочу первой поздравить его с днём рождения, поэтому попросила Алису его не поздравлять, пока это не сделаю я."
    "Я уверена, он опять улыбнётся мне как дурак, я объяснюсь перед ним и всё пройдёт."
    window hide

    $ renpy.pause(1, hard=True)

    stop ambience fadeout 6
    stop music fadeout 6
    scene black with dissolve3
    $ renpy.pause(3, hard=True)
    if config.developer == False:
        if persistent.us_usrd_end_scr == False:
            $ persistent.us_usrd_end_scr = True
            $ notdream_achievment("usrd_end_ach")

    
    $ renpy.pause(1, hard=True)

    jump credits_nd_as

