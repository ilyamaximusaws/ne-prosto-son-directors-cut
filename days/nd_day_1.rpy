    window hide

    $ renpy.pause(1)

    window show
    nd_il "Хе."
    "Усмехнулся я, отчего сразу же поймал взгляд маленькой пионерки."
    nd_il "Весело тут у вас."
    window hide

    $ renpy.pause(1)

    show us smile sport far at center with dspr

    window show
    usp "А-то!"
    "Отдышавшись, произнесла девочка."
    usp "Понравился мой розыгрыш?"
    nd_il "Ну да, круто..."

    if persistent.us_us_end_scr != True:
        "Сказал я неуверенно и поднял кончик своей губы.{w} Наигранно, но это сработало."
    elif persistent.nd_fix_end == True or persistent.nd_fix_end == False:
        "Мне на секунду показалось, будто в груди что-то сжалось под необъяснимым чувством, подозрительно походившим на страх.{w} И это чувство показалось мне до боли знакомым."
        "Но девочка с необыкновенно рыжими волосами, судя по всему, этого не заметила."
    else:
        "Я чуть не задохнулся от волнения, поселившегося у меня в груди."
        "Но девочка с необыкновенно рыжими волосами, судя по всему, этого не заметила."

    show us grin sport far with dspr

    usp "А ты кто такой? Я точно не видела тебя в этом лагере раньше."
    if persistent.nd_fix_end == True or persistent.nd_fix_end == False:
        th "Не видела..."
    usp "Ах, так ты новенький?! Да ещё и издалека к нам приехал?"
    show us surp1 sport far at center with dspr
    usp "Ах, так ты новенький?! Да ещё и издалека к нам приехал?{fast} С севера?"
    "Произнеся свой последний вопрос, она явно имела ввиду мою весеннюю куртку."
    th "Упс…"
    hide us with dspr
    "Я принялся снимать свою куртку, жалея, что не догадался снять её тогда, когда ещё стоял перед воротами в это место."
    nd_il "Да нет, я наоборот, с жарких краёв…"
    show us grin sport far with dspr
    usp "Ага, я прям так и поверила!"
    show us smile sport far with dspr
    usp "Ясно. Тебя как звать-то?"

label d1_us_hello_label_f5:

    nd_il "Ильёй меня зовут.{w} Для друзей просто Илья."
    "Неуверенно ответил я с фальшивой, с силой натянутой до ушей улыбкой."
    "Я был не в курсе, как они тут знакомятся, но в груди что-то мне подсказывало, что я сказал что-то не то."
    show us grin sport far with dspr
    us "Очень приятно. А меня Ульяной, друзья называют как им хочется."
    "Передразнила она меня, отчего я невольно улыбнулся."
    us "Будем товарищами?"
    hide us with dspr
    "Сказав это, она протянула мне свою руку."
    nd_il "Будем."
    "Я аккуратно пожал руку девочки.{w} Она была очень нежной, от чего казалась хрупкой, но это не мешало девочке совершать крепкое (по её мнению) рукопожатие."
    "Но я о чём-то забыл..."
    "В другой руке у этой девочки было насекомое, которым она напугала девочку с книгой и, видимо, хотела напугать им и меня, бросив его мне на мою рубашку, которую я привез в этот лагерь из будущего."
    nd_il "Я не боюсь насекомых."
    "Сказал я и вернул кузнечика Ульяне."
    show us smile sport far with dspr
    us "Я, кстати, тоже..."
    "Будто что-то замыслив, она улыбнулась мне и спрятала бедного жучка в карман своих шорт."

