#---------------------------------------------------------------------------
# Не спойлери себе игру! 
#---------------------------------------------------------------------------
# v.2

label notdream_prolog_d1:

    $ renpy.pause (1, hard=True)

    $ nd_change_time('prolog')

    $ renpy.pause (1, hard=True)

    $ volume (1, "ambience")
    $ volume (1, "music")

#    if config.developer == True:
#        scene nd_developer_mode_alert with dissolve
#        $ renpy.pause (60, hard=False)
#        hide nd_developer_mode_alert 
#        scene black
#        with dissolve

    play music ndm_list["LP_in_the_end"] fadein 4
    scene bg present_d1d1 with nd_effect_5_reverse

    $ renpy.pause (2, hard=True)
    show black with dissolve
    $ new_chapter(1, u"Это не просто сон, верно?\nВведение")
    $ renpy.pause (1, hard=True)
    show anim prolog_1 with dissolve2
    $ renpy.pause(1)

    if autosave_autoload_unlocker == 1:
        $ persistent.autosave_autoload_unlocked = True

    $ renpy.block_rollback()

    window show
    "Любая история, пусть-то маленький рассказ или трёхтомная поэма, имеет своё начало и конец."
    "Экспозиция, завязка, развитие сюжета, кульминация, развязка и конец с эпилогом."
    "Свет включается, люди поднимаются с кресел и выходят из зала.{w} Книга закрывается и кладётся на полку.{w} Альбом заканчивается на последней фотографии."
    "Но что насчёт этой истории? Не является ли она исключением из правил?{w} Очевидно, в ней нет начала, ведь я совсем его не помню."
    "Так же, как не помню начало своего существования..."
    "А с чего вообще началось оно...{w} Моё начало?"
    window hide

    $ renpy.pause(2)

    window show
    "Может, оно и к лучшему?{w} Может, та жизнь, которой я сейчас живу, на самом деле идеальна?"
    "Скорее размеренная, ничего идеального не существует.{w} По крайней мере я ещё не встречал..."
    window hide

    $ renpy.pause(1)

    window show
    "Все постоянно идут к чему-то.{w} Стараются что-то менять к лучшему,{w} спешат куда-то.{w} А я всего лишь плыву по неспешному течению этой жизни."
    "И буду плыть, пока внутри течёт та самая красная субстанция, позволяющая мне жить."
    "Жить и надеяться, что рано или поздно я проснусь."
    window hide 

    $ renpy.pause(1)

    scene black with dissolve2
    $ renpy.pause(2)
    show anim prolog_4 with dissolve2

    nvl clear

    $ set_mode_nvl()

    window show
    "Недавно и у меня в жизни наступил переломный момент - двадцатилетие."
    "Друзей и знакомых на празднике не было.{w} Да и поздравительные звонки с пожеланиями мне не по вкусу."
    "Для меня это был обычный будний день, как и для большинства людей на планете."
    "Многие назовут мой образ жизни отшельническим, ведь я совсем не выхожу из своего дома и тем более квартиры."
    "Всё, что находится за окном{w} - это общество, в которое я уже совсем давно потерял веру."
    "Мне приятнее смотреть на строки работающего кода, чем на мир вокруг, враждебность которого впилась под кожу."
    "И ведь я даже не знаю, почему это так. Что повлияло на это?{w} Страна?..{w} Мои знакомые?..{w} Родители?.."
    window hide

    $ renpy.pause(1)
    nvl clear

    window show
    "Потихоньку я начал забывать многие важные моменты из своей жизни.{w} И в конце концов забыл всё, что происходило со мной когда-то."
    "Про всё, кроме холодного безразличия ко всему живому, что меня окружает."
    "Нет... Не совсем всё... Есть кое-что, что не хочет вылезать из головы, как бы я не пытался отвлечься"
    "Тот самый сон..."
    window hide
    
    $ renpy.pause(1, hard=True)

    $ set_mode_adv()

    stop music fadeout 2
    scene black with dissolve2
    $ renpy.pause (1)
    scene bg disclamer2 with nd_effect_5
    $ renpy.pause(0.1)
    play sound ndm_list["nd_lightsout"] fadein 1
    scene bg disclamer3 with nd_effect_5
    $ renpy.pause(60)
    stop sound fadeout 3
    show black with dissolve2
    $ renpy.pause (1)
    scene what_you_done with dissolve2

#    $ notdream_achievment("achievment_notdream_start")
    $ renpy.pause (3.5, hard=True)

    show black with dissolve2
    $ new_chapter(1, u"Это не просто сон, верно?\nПролог")
    $ renpy.pause (1)
    play music ndm_list["RF_wake"] fadein 4
    scene ext_camp_entrance_day
    show prologue_dream
    with dissolve2

    $ renpy.fix_rollback()

    window show
    "Всё началось с одного очень странного сна…"
    "Я врос ногами в асфальт перед воротами лагеря.{w} Ассоциация с Советским Союзом всплыла в сознании сама собой."
    "Мне никогда не приходилось бывать в лагерях давно не существующего государства, хотя могу и ошибаться."
    "О существовании таких лагерей мне рассказывала мать перед сном, когда я был совсем мал.{w} Было интересно слушать её истории..."
    "Сейчас я потерял контакт с родителями настолько, что даже не знаю, живы они или нет.{w} Но от прошлого лучше вернёмся к моему сну."
    "Слева и справа от ворот стояли статуи пионеров, а над воротами красовалось название лагеря:{w} \"Совёнок\"."

    scene ext_road_day
    show prologue_dream
    with dissolve

    "Позади меня лентой вдаль тянулась дорога."
    "Ей не было конца.{w} Бесконечная линия, уходящая в горизонт.{w} Линия жизни?{w} Пожалуй."
    "Никто не знает, что будет тебя ждать на ней..."

    scene ext_camp_entrance_day
    show prologue_dream
    with dissolve

    "Когда за воротами что-то быстро и стремительно промелькнуло,{w} у меня зазвенело в ушах,{w} и я вновь оказался в своей квартире на своей кровати..."
    window hide

    stop music fadeout 3
    show black
    hide prologue_dream
    with dissolve2

    $ renpy.pause(2)
    play music ndm_list["how_sad"] fadein 6
    scene bg nd_bg_psychabinet
    hide blink
    show unblink
    $ renpy.pause(1)

    window show
    psih "Илья, неужели Вы больше ничего не помните?"
    play sound sfx_inhale
    "Я тяжело вздохнул."
    nd_il "Совсем."
    psih "Постарайтесь вспомнить другие детали.{w} Может рядом что-то было?"
    psih "Может какой-то ориентир, надпись на стене, транспорт?"
    "Спросил психотерапевт, позволив мне порыться в своём сознании некоторое время и отыскать ответ на его вопрос."
    window hide

    $ renpy.pause(2)

    window show
    nd_il "Да,{w} точно,{w} кажется...{w} Там был автобус."
    window hide

    show black with dissolve

    $ renpy.pause(2)
    scene ext_bus
    show prologue_dream
    with dissolve

    window show
    "Этот автобус выглядел современней места, в котором находился."
    "Над лобовым стеклом висел его номер.{w} Четыреста десятый, если я не ошибаюсь."
    "Странно, но за рулём никого не было.{w} Создавалось ощущение, что меня привезли в этот лагерь на нём."
    window hide

    scene black
    hide prologue_dream
    with dissolve
    $ renpy.pause(1, hard=True)
    scene bg nd_bg_psychabinet with dissolve

    window show
    psih "Хорошо.{w} Вам в первый раз снился этот сон?"
    "Произнес психотерапевт, продолжая записывать всё мною сказанное в свою записную книжку, в которой, по меньшей мере, было исписано уже страницы три, если не больше."
    "Я вновь откинулся на спинку кресла-качалки и продолжил диалог с ним, не переставая пробовать взглядом его внешность на вкус."
    "Это был мужчина в очках, блондин, с ухоженными волосами и в смокинге, постоянно спокойный.{w} Видимо, он очень любит своё дело, раз так терпеливо ожидает моего ответа."
    window hide

    $ renpy.pause(1)

    window show
    nd_il "Да.{w} Понимаете, я с трудом могу назвать это сном.{w} Всё было так реалистично, будто я сам нахожусь там."
    nd_il "Как наяву, но всё равно во сне."
    nd_il "Возникало чувство, как будто знаешь, что это сон, но всё равно веришь в реальность всего происходящего."
    psih "То есть это с вами не в первый раз?"
    nd_il "Да.{w} Именно.{w} Что-то подобное мне уже снилось, и в первый раз я не придал этому особого значения."
    nd_il "Я будто всё сильнее и сильнее стал погружаться в эти сны.{w} Стал чаще их видеть."
    nd_il "И этот раз стал для меня последней каплей. Я хочу разобраться, что происходит со мной и в моей голове."
    window hide

    $ renpy.pause(1)

    window show
    psih "Хорошо.{w=0.3} Как вы сказали, вы не помните, кем вы были раньше и из-за чего всё началось."
    psih "Это может быть вызвано психологической травмой, которая могла произойти с вами очень давно, и которая нанесла сильный удар по вашей психике."
    "На эти слова психотерапевта я скромно кивнул головой пару раз."
    psih "Сам этот случай со сном достаточно интересен для изучения, особенно если Вы не помните, что бывали в лагерях в детстве."
    psih "Вот, возьмите этот номер. Вы можете позвонить, если это приснится вам снова."
    "Сказал психотерапевт, достав бумажку, и начиркав свой номер телефона, протянул её мне."
    nd_il "Спасибо..."
    window hide

    $ renpy.pause(1)

    scene black with nd_effect_5_reverse
    $ renpy.pause(1, hard=True)
    scene bg int_school_ext_nd
    show int_school_night
    with nd_effect_5_reverse

    play sound sfx_steps_clubs_nextroom

    window show
    "Попрощавшись с ним, я спустился по лестнице на первый этаж и через полупрозрачные двери вышел на улицу, стараясь не принимать во внимание всё, что меня окружает."
    "Я был погружен в мысли, полностью цитирующие этого психотерапевта, имени которого я уже не помнил."
    window hide

    $ renpy.fix_rollback()

    show black with dissolve2
    stop sound
    stop music fadeout 2
    $ renpy.pause(1)
    play ambience nds_list["traffic_outside"] fadein 2
    $ renpy.pause(1)
    play sound_loop sfx_intro_bus_stop_steps
    show anim intro_4 with dissolve
    $ renpy.pause(1, hard=True)
    show anim intro_3 with dissolve

    window show
    "Я удивился от того, что на улице достаточно светло от фонарей и окон в отдаленных жилых домах."
    "Было холодно настолько, что моя весенняя куртка была не в состоянии меня спасти, даже если бы очень старалась."
    "Странный этот Краснодар. Лето очень жаркое, а зима холодная, словно на северном полюсе."
    "Хотя я и приехал сюда только под конец лета, и только успел ужиться в большом городе."
    "До этого для меня были открыты только посёлки городского типа на Кавказе, которые омерзительно бесперспективны."
    "Особенно для такого заядлого программиста, как я."
    "Я с ухмылкой вспоминал о том, как пытался найти себя в этом мире и занять свою роль в обществе."
    "Или не пытался... Все воспоминания сохранились лишь размытыми фактами, всплывающими случайным образом в моей голове.{w} Это явление было странным, но именно эта странность меня и поражала."
    window hide

    $ renpy.pause (1)

    window show
    "До остановки было примерно полкилометра, поэтому дорога обещала быть недолгой."
    window hide

    $ renpy.pause(1, hard=True)
    show anim intro_5 with dissolve
    $ renpy.pause(1, hard=True)
    show anim intro_6 with dissolve

    window show
    "Идти, слушая звуки колёс автомобилей, рассекающих снег и грязь по асфальту, было довольно скучно.{w} Благо я всегда с собой носил телефон и наушники."
    "Достав эту парочку, я развязал нехитрый узел,{w} каким-то магическим образом образовавшийся у меня в кармане,{w} и вставил штекер в разъем телефона."
    "Теперь дело оставалось за малым — выбрать музыку под настроение."
    window hide

    $ renpy.pause(1)

    window show
    "Гигабайты музыки разных жанров, длины и качества. Я был ещё и заядлым меломаном, способным кайфовать под любую музыку. Будь то рок, рэп, хип-хоп и миллион других жанров, названий которых я даже не знаю."
    "Вот как можно назвать жанр, в котором сочетаются Lo-Fi и хард рок? Витчхаус? Соулвейв?"
    "В любом случае, сейчас мне нужно было выбирать из этого огромного списка один единственный трек, с которого должно начаться моё погружение в бездонный плейлист."
    "И в этом мне помогал великий рандом. А точнее палец, в любой момент остановившийся во время прокрутки списка треков."
    "Иногда мой палец мог попасть между двумя песнями, и тогда мне приходилось выбирать одну. Но этот случай стал исключением."
    "Палец остановился на песне с названием: \"Грустишь?\" и исполнителем \"Попробуй\". Оба этих тега отображались через дефис, так что это выглядело, как принуждение или моё послание мне же из будущего."
    "Я невольно улыбнулся, и решил послушать этот трек, фактически подаренный мне судьбой."
    window hide

    stop ambience fadeout 4
    $ renpy.pause(1)
    show black with dissolve2
    stop sound_loop fadeout 3
    play music ndm_list["in_my_zone"] fadein 3

    window show
    "Включив его, в уши полилась успокаивающая мелодия, а точнее какой-то новомодный бит, под который реперы обычно плачут о том, что у них всё плохо в жизни. Плачут, имея крышу над головой и обувь на ногах..."
    "Но сам этот бит успокаивал и наталкивал на какую-то умственную активность."
    "В этой мелодии был смысл.{w} Иначе она бы не зацепилась за сердце."
    "Эта мысль меня отчасти и подтолкнула на дальнейшие размышления."
    th "Что это был за лагерь?{w} Может быть, это место нечто большее, чем спонтанный всплеск моей больной фантазии?"
    th "Больше, чем игра разума вкупе с отголосками старых воспоминаний?.."
    th "А может, дело в чём-то потустороннем? Но я давно не верю во все эти бредни про гадалок и экстрасенсов."
    th "Всё это - шарлатаны, пытающиеся нажиться на чужом горьком событии в жизни."
    th "Даже от психотерапевта, которого я только что посетил, вышло больше пользы.{w} По крайней мере, я знаю о своей какой-то травме, и о том, куда обращаться при повторном таком сне."
    window hide

    $ renpy.pause(2)
    show anim intro_7 with dissolve2

    window show
    "Спустя некоторое время показалась моя остановка."
    "Здесь мне нужно будет сесть на автобус и доехать до другой, которая находится практически рядом с моим домом."
    "Секундочку...{w} А вот и он...{w} Едет, да так неспеша..."
    window hide

    show anim intro_9 with dissolve

    window show
    "К остановке подъезжает автобус, который, в теории, должен был доставить меня до моего дома."
    "Так как я жил на конечной, то мог спокойно садиться на любой автобус, не глядя на его номер."
    "Уж очень удачное место я выбрал для проживания, что к нему едет большинство автобусов города."
    th "Будет иронично, если этот автобус привезет меня прямо к воротам того лагеря..."
    "Я усмехнулся.{w} Мысли, бредовее этой, ко мне в голову ещё не приходило."
    window hide

    $ renpy.pause(2, hard=True)

    stop music fadeout 1
    play sound_loop sfx_intro_bus_engine_loop fadein 2
    show anim intro_10 with dissolve
    $ renpy.pause(2)
    show anim intro_11 with dissolve
    $ renpy.pause(2)
    show black with dissolve
    stop sound_loop fadeout 2
    play sound sfx_bus_out fadein 2
    $ renpy.pause(2)
    play music ndm_list["in_my_zone"] fadein 1
    scene intro_xx with dissolve

    window show
    "Добежав до автобуса, я поспешно зашёл в него, и, оплатив проезд, сел на одно из свободных мест."
    "Эти места были, конечно, до жути неудобными.{w} Приходилось постоянно ворочаться, чтобы занять удобную для себя позицию."
    "Но не мне на это жаловаться, ведь для какого-нибудь богатенького дядьки это сидение покажется неотёсанным камнем.{w} Хотя навряд ли богатые будут ездить на чём-то, дешевле своего Майбаха или Роллс Ройса с нещадно дорогой комплектацией."
    "Я никогда не мечтал о подобной жизни, как у них. Богатые зачастую одни из самых омерзительных людей на земле. От богатства вскоре сносит башку, и ты становишься психически нездоровым."
    "Я рос в небогатой семье. Но какое это сейчас имеет значение, когда кроме компьютера и обеспечивающих меня знаний в программировании в моей жизни ничего не осталось?"
    window hide

    $ renpy.pause(2)

    window show
    "Было странным, что вечером в автобусе никого не было.{w} Лишь девушка, читающая \"Википедию\" то ли от интереса, то ли от скуки. Вот он, двадцать первый век: развитие от лени превысило развитие от жажды новых знаний."
    th "Люди читают википедию, статьи на которой пишут люди вроде меня и их самих. Хех..."
    "Однако сейчас меня это не слишком заботило, ведь через пол часа я буду в своей квартире, ставшей родным и единственным гнездом для меня."
    "Перед окном будет стоять мой компьютер, за которым я большинство времени работаю, играю в игры, и листаю форумы по софту, социальной инженерии и другой всячине."
    "Интернет для меня за последние несколько лет стал своеобразным прорубем, в котором мне приятней находится, чем на улице среди чумазого от своих низких потребностей общества."
    "И от мысли об этом меня невольно бросило в дрожь..."
    window hide

    $ renpy.pause(2)

    window show
    th "Интересно, какова вероятность того, что я смогу стать частью этого общества?"
    th "После сотни неудачных попыток и всего, что я успел увидеть в той жизни..."
    th "Люди здесь живут иначе.{w} Проще, что ли.{w} И смотрят на мир не так, как те, что попадались мне раньше."
    th "И даже здесь не обойдётся без этого противного человеческого лицемерия..."
    window hide

    $ renpy.pause(1)

    window show
