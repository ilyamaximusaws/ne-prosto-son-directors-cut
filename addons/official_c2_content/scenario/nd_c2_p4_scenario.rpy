init:

    $ nd_c2_p4_point1 = False
    $ nd_c2_p4_point2 = False
    $ nd_c2_p4_point3 = False
    $ nd_c2_p4_point4 = False

label nd_c2_partFour:

    $ new_chapter(1, u"Фикционализм\nЧасть IV - Забота")
    $ nd_change_time('prolog')
    $ renpy.pause(4, hard=True)

    window show
    nd_il "Извини, я забываю тебя."
    nd_il "Позволь мне побыстрей успокоиться."
    nd_il "Меня мотало, будто я остался один на берегу чужого океана."
    nd_il "И это не моя вина..."
    window hide

    $ renpy.pause(3, hard=True)
    $ volume(0.1, 'back_ambience')
    play ambience nda_list['nd_winter_park'] fadein 5
    play back_ambience nda_list['nd_winter_pka_back'] fadein 5
    scene bg snowy_city_background 
    show snow
    with dissolve3
    $ renpy.pause(1, hard=True)

    window show
    "Этот эксперимент не может длится вечно."
    "Его цель - заставить меня принять эту реальность."
    "Моя цель - узнать, что от меня скрывается за стенами этой \"матрицы\"."
    window hide

    $ renpy.pause(1, hard=True)

    play music ndm_list['top_bandito_slowed'] fadein 5

    window show
    "Этот каток был для меня чётко узнаваем. Я помню многие моменты, связывающие меня с ним."
    "Например момент признания самому себе, что мой собственный образ мне противен, хоть и выполняет свою главную функцию."
    "Функцию скрывать свои настоящие чувства."
    "Хотя в последствии я забыл, какие чувства мне нужно скрывать. И зачем мне нужно было скрывать пустоту?.."
    window hide

    $ renpy.pause(1, hard=True)

    window show
    "Внутри своей прогнившей от безнадёги души..."
    "Я понимаю, как много для меня значит моё прошлое, которое вот-вот вспомню."
    "Хотелось закурить, хотя я и не курил раньше."
    window hide

    $ renpy.pause(1, hard=True)
    show blink
    $ renpy.pause(1, hard=True)
    
    window show
    "Я закрыл глаза, слушая восторженные голоса вдалеке."
    "Казалось, что меня там кто-то ждёт, зовёт, приказывает подойти немедленно, волнуется за меня."
    "Как мама, которая никогда за меня не волновалась."
    "Это приходилось делать моей близкой на тот момент подруге, ведь моей сестры тогда уже не было на этом свете."
    "Когда я что-то делал неправильно, она по-доброму меня отчитывала. И я не то чтобы расстроен. Я скучаю по ней..."
    window hide

    play sound sfx_inhale
    $ renpy.pause(1, hard=True)

    window show
    nd_prophet "Твоя мизантропия завораживает..."
    window hide

    hide blink
    show pi3 normal at right behind snow
    show unblink

    stop music fadeout 15

    window show
    nd_prophet "Почему не присоединишься к ним?"
    nd_il "Нет желания."
    "Робко ответил я, в надежде повесить молчание."
    nd_prophet "Так говорит нейросеть, а не ты."
    nd_prophet "Эта нейросеть во главе всего мироздания. А тебе нужно её одолеть."
    nd_il "Разве что моя нейросеть."
    nd_prophet "Сегодня её последний день, и мы наконец выберемся отсюда. И вы с девочкой тоже."
    "Наконец он заинтересовал меня, и это должно было отразиться в моём взгляде."
    nd_prophet "Ты ещё многого не знаешь..."
    window hide
    
    $ renpy.pause(2, hard=True)
    hide pi3 with dspr

    window show
    "Он сел рядом со мной на оледеневшую скамейку."
    "Я почувствовал, как её холод врезался в мою спину."
    nd_il "Как же ты надоел разговаривать загадками."
    stop music fadeout 7
    nd_prophet "Тот день, когда я разговаривал загадками, уже давно канул в лету."
    nd_prophet "С этого момента мы с тобой едины. Ведь наши цели совпали."
    nd_il "Нет, ты говорил, что твоя цель - выбраться из этой \"матрицы\"."
    nd_prophet "А ты хочешь жить в ней вечно?"
    window hide

    $ renpy.pause(1, hard=True)
    
    window show
    nd_il "Я уже не знаю, чего я хочу."
    nd_prophet "Ты боишься, что больше никогда не встретишься с этой девочкой."
    "Констатировал он так, будто мы в прямом смысле объединились с ним."
    nd_prophet "Мы привыкаем к вымыслам, которые сами же и создаём."
    nd_prophet "Ты можешь найти ту же самую Ульяну в другом человеке, ты же это понимаешь?"
    th "Я боюсь начинать сначала..."
    nd_prophet "А ты начни. Увидишь, как тебе станет лучше. Того и глядишь, интерес к жизни появится."
    nd_prophet "На одного тульповода в мире станет меньше."
    nd_il "То есть она не настоящая?"
    window hide

    play music ndm_list['Outsider_No_More_Cyber'] fadein 4
    $ renpy.pause(3, hard=True)

    window show
    nd_prophet "Я не могу этого знать. Не могу знать тебя. Могу лишь догадываться, какой ты в том - реальном мире."
    nd_prophet "Да и понятие \"реальный мир\" относительно."
    nd_prophet "Короче, просто сохрани в себе мысли, которые были в тебе до магического попадания в лагерь."
    nd_il "Есть у меня одна мысль касательно всего этого."
    nd_il "Если ты создал \"цифровое бессмертие\", значит и этот проект тоже твой."
    nd_il "А значит ты создал лагерь и пионерок в нём."
    nd_prophet "Основанных на образах внутри твоей головы."
    nd_prophet "И да, я не создавал миры и всё это.{w} Создала нейросеть. Причём в её программном коде заложена функция переписывания сознания."
    window hide

    $ renpy.pause(2, hard=True)

    window show
    nd_il "А как тогда я тут оказался?"
    nd_prophet "По одной из моих версий - принял участие в эксперименте на этапе его зарождения."
    nd_prophet "Оцифровка коры головного мозга не такой уж и сложный процесс."
    nd_il "А какие ещё версии у тебя есть?"
    nd_prophet "Есть версия, что твой целый мозг подключили к нейросети, и она выделила для тебя место на сервере компании."
    nd_prophet "Я, к сожалению, уже не знаю, на какой стадии разработки находится мой давнишний проект. Поэтому делаю предположения."
    nd_prophet "С 2103 года всё могло сильно измениться, в том числе способ \"оцифровки\"."
    window hide

    $ renpy.pause(3, hard=True)

    window show
    "Меня будто парализовало после нашего с Пророком диалога."
    "Одолевающие сомнения закрались в мой мозг. Сомнения в том, что я когда-то существовал."
    "После этих домыслов я задумывался о покое, который с этих пор будет мне только сниться."
    nd_prophet "Ещё хочу тебя обрадовать - ты не единственный такой мозг."
    nd_prophet "Возможно, ты в лагере встретил девочку, сознание которой тоже было оцифровано."
    nd_prophet "Причины оцифровки конечно есть. Это может быть тяжёлая болезнь пациентки или её личное желание."
    nd_prophet "К слову, я принял это решение, потому что мой мозг неправильно функционировал из-за врождённой болезни."
    nd_prophet "Как видишь, нейросеть умудрилась даже это поправить."
    window hide

    $ renpy.pause(1, hard=True)

label nd_c2_partFour_otv:

    menu:
        "И как закончить эксперимент?" if nd_c2_p4_point1 == False:

            $ nd_c2_p4_point1 = True

            window show
            nd_il "И как мне закончить участие в эксперименте?"
            nd_il "Я могу просто вслух произнести, что мне надоело, или выбросится с окна?"
            nd_prophet "Не всё так просто. Информация об этом содержится на электронном бланке, когда тебе его предоставляют и ты его подписываешь."
            nd_prophet "Когда я работал в компании, тебе нужно было вписать секретное стоп-слово на латинском, которое вне контекста расценивалось как отказ от оказания дальнейших услуг."
            nd_prophet "Тебя выкидывали из симуляции и в течении некоторого времени обнуляли кору головного мозга, очищали данные."
            nd_prophet "Это означало добровольное самоубийство."
            nd_prophet "Нередки случаи, когда пациенты забывали секретные слова, тогда их обнуляли с приходом смерти в симуляции."
            nd_prophet "Как ты выразился, \"выбрасывались с окна\"."
            window hide

            jump nd_c2_partFour_otv
            
        "И какая же причина оцифровки у Ульяны?" if nd_c2_p4_point2 == False:
            $ nd_c2_p4_point2 = True

            window show
            nd_il "И какая же причина оцифровки у Ульяны?"
            nd_prophet "Я не знаю. Информация об этом есть только у наблюдателей - отдельных от основной нейросети сотрудников персонала."
            nd_prophet "Грех не воспользоваться роскошью, к которой причастен сам же."
            nd_il "И почему же тебя не взяли наблюдателем?"
            nd_prophet "Тогда ещё не было иерархий таких \"неокортексов\". Я просто был первым и довольствовался этим, пока не встретил на этих цифровых просторах тебя."
            nd_prophet "Как я думал, ты создавал помехи главной нейросети и она запуталась в том, \"что тебе нужно\"."
            nd_prophet "Оставаться в лагере было опасно, как раз по этой причине.{w} Ты сам видел, что с ним происходило."
            window hide

            jump nd_c2_partFour_otv
        
        "Почему я должен уничтожить нейросеть?" if nd_c2_p4_point3 == False:
            $ nd_c2_p4_point3 = True

            window show
            nd_il "И почему тогда я должен рубить руку, которая меня кормит?"
            nd_prophet "Ты про нейросеть? Если да, то вся проблема в том, что кормит она тебя не тем и не туда."
            nd_prophet "Вот тебе и остается либо блуждать по ней, не найдя себе пристанища, либо остаться в стабильном её куске и жить."
            nd_il "Скорее существовать. Жизнью то, что ты описал, не назовёшь."
            nd_prophet "Сюда приходят люди как раз чтобы жить. Вот и ты пришёл в проект и попросил чтобы тебе стёрли память до твоего двадцатилетия, как многие хотели бы."
            nd_prophet "Но так как технология несовершенна, ты по какой-то причине стал несовместим с нейросетью."
            nd_prophet "Возвращаясь к аналогии с рукой, тебе надо указать ей, как правильно тебя кормить."
            nd_prophet "А не \"рубить\" её, как ты вначале выразился."
            nd_prophet "И со мной у этой нейросети такая же проблема. Поэтому я и хочу, чтобы ты мне помог."
            window hide

            jump nd_c2_partFour_otv

        "Я узнал всё, что хотел.":
            window show
            nd_il "Спасибо что пролил свет на всё это. Это очень помогло."
            nd_prophet "Главное не сдавай позиции. Нам ещё предстоит долгий путь."
            nd_prophet "Не забывай о том, что я тебе поведал."
            "Он приобнял меня."
            show blink
            "Я опустил голову и закрыл глаза, растворившись в надвигающейся на меня материи."
            window hide

            stop music fadeout 5
            stop sound_loop fadeout 5
            stop ambience fadeout 5
            stop back_ambience fadeout 5

            $ renpy.pause(5, hard=True)

            window show
            "Порой мы видим сны, которые кажутся нам бредом и не запоминаем их."
            "Сны, которые открывают нам правду сознания часто не имеют значения для нас. То же самое и с безумными снами."
            "До этих пор я не знал, как реагировать на подобные выпады в мою сторону со стороны больного сознания."
            "Теперь же я могу увидеть всю их поднаготную, изучить их природу, и уже потом принять решение."
            "Моё решение - жить и наслаждаться жизнью. Я это заслужил..."
            window hide

            stop music fadeout 5

            $ renpy.pause(2, hard=True)
            
            jump nd_c2_partFour_cont

label nd_c2_partFour_cont:

    show nd_g_2_part_4_text with dissolve2
    $ renpy.pause(3, hard=True)
    $ nd_change_time('day')
    play ambience nda_list['int_ambience_humans'] fadein 4
    scene bg nd_int_bashops with dissolve2

    window show
    "Не хватило и пяти минут, чтобы прийти в себя."
    "Кто-то назовёт это провалом в памяти, кто-то сонной несознательностью, а кто-то даже ленью."
    "Тем не менее, окончательно вернуться в самого себя мне удалось только в парикмахерской, где девушка, прекрасно орудующая ножницами, делала для Ульяны самую лучшую причёску."
    "Где-то неумолимо парикмахеры без работы разговаривали друг с другом о бытовых вещах, а слева от меня парень расплачивался за новую причёску."
    "Я сначала посмотрел на время, затем проверил баланс на карточке в мобильном банке."
    window hide

    $ renpy.pause(2, hard=True)

    window show
    "На моём счету было не много и не мало. Это зависило бы от города, где мы находимся, и мира, в котором мы с ней оказались."
    "Этого хватило бы ещё на пару месяцев, но только если бы я не сообразил доделать и сдать свою работу, пока Ульяна прихорашивалась для нашей прогулки."
    "В четыре часа на мой счёт должно было прийти чуть больше сотни тысяч рублей за сданную мной работу вовремя."
    window hide

    $ renpy.pause(2, hard=True)

    window show
    "Не знаю с чем это было связано, но девочка сидела перед зеркалом с закрытыми глазами."
    "Может быть, она хотела получить наибольшее удивление от результата, а может боялась, что волосы попадут ей в глаза."
    "Но я видел это, и тихо прощался с такими знакомыми мне снопами волос у неё на голове, про себя думая о том, что они ещё вернутся."
    "А пока мне остаётся только лишь дожидаться свою красавицу.{w} Надеюсь, ей понравится новая прическа."
    window hide

    stop ambience fadeout 5
    show black with dissolve2
    $ renpy.pause(6, hard=True)
    play ambience nda_list['ambience_int_apartaments_neutral'] fadein 5
    hide black with dissolve2

    $ renpy.pause(0.5, hard=True)

    window show
    "Прошло ещё около десяти минут, после чего волосы Ульяны были окончательно уложены."
    "И вот, парикмахерша убирает пеньюар, девочка открывает глаза, и я вижу через зеркало её приятно-удивлённое лицо."
    window hide

    $ renpy.pause(1, hard=True)

    show us surp1 nd_dress far at cleft with dspr

    window show
    us "Ух-ты-ы-ы!"
    "Краем глаза я заметил, как парикмахерша после слов Ульяны расплылась в улыбке."
    window hide

    $ renpy.pause(0.5, hard=True)
    hide us with dspr
    $ renpy.pause(0.2, hard=True)
    show us surp3 nd_dress at center with dspr
    
    window show
    us "Смотри какая я теперь красивая!"
    nd_il "Красивее красивого."
    "Сказал я, погладив Ульяну по плечу."
    window hide
    
    $ renpy.pause(1, hard=True)
    hide us with dspr

    window show
    nd_il "Сколько с нас?"
    nd_barplady "Ваша прическа будет стоить пятьсот, а вашей юной леди - тысячу…"
    window hide

    $ renpy.pause(1, hard=True)

    window show
    "Оплатив свою радость и радость моей \"юной леди\", мы попрощались с парикмахершей и направились на улицу."
    nd_barplady "Приходите к нам ещё!"
    us "Обязательно придём!"
    "Ульяна была уже у выхода из парикмакерской и продолжала любоваться своим видом."
    nd_il "Спасибо вам, до свидания."
    window hide

    stop ambience fadeout 3
    scene black with dissolve2
    $ renpy.pause(2, hard=True)
    play ambience nda_list ['ambience_city_ambient'] fadein 4
    scene bg nd_city_up_2 with dissolve2

    window show
    "К слову, снаружи было достаточно тепло, особенно для осени."
    "Обычно такое явление называют бабьим летом, но в тот момент я почему-то постеснялся мыслей об этом."
    show us smile nd_dress at center with dspr
    us "Ну что, куда нам с тобой дальше?"
    "Спросила у меня Ульяна, показав свои зубки в широкой улыбке."
    nd_il "Я думаю познакомить тебя с новыми технологиями подробно, а точнее – куплю тебе свой собственный смартфон."
    us "Это такая книжечка как у тебя?"
    nd_il "Ага.{w} А пока давай прогуляемся по во-о-он тому парку..."
    hide us with dspr
    "Проговорил я и показал на него пальцем. "
    "Он находился через дорогу, а мы находились как раз в десяти метрах от пешеходного перехода."
    "Пока горел зелёный сигнал светофора, мы с Ульяной сначала прибавили шаг, а потом и перешли на бег."
    window hide

    stop ambience fadeout 4
    $ renpy.pause(1, hard=True)
    play sound_loop nds_list['nd_run_on_road'] fadein 1
    scene black with dissolve
    $ renpy.pause(4, hard=True)
    stop sound_loop fadeout 4
    play ambience nda_list['nd_es_park_1'] fadein 4
    scene bg nd_city_park_2 with dissolve2
    $ renpy.pause(0.5, hard=True)

    window show
    "Неудивительно, что в парке никого не было в будние дни.{w} Он не пользовался большой популярностью и был полностью под властью природы."
    "Складывалось ощущение, что находишься на какой-нибудь лесной опушке, но изредка проходящие люди быстро разрушали эту иллюзию."
    "Здесь можно было хорошо погулять и освежиться, либо просто посидеть на скамейке и отдаться своим поистине ветренным ощущениям."
    us "Тут тихо."
    nd_il "Давай присядем что-ли ненадолго."
    nd_il "Хочется мне природой насладиться, понимаешь наверное."
    show us shy nd_dress at left with dspr
    us "Угу..."
    us "Мне тоже нравится природа!"
    window hide

    hide us with dspr
    $ renpy.pause(1, hard=True)

    window show
    "Мы решили остановиться практически перед самым входом в этот парк для одной цели{w} - остаться наедине."
    show us smile nd_dress at left with dspr    
    us "Когда я только приехала в лагерь, первое время вообще глаз не отрывала от пляжа и леса."
    us "Надо же как идеально вписаться было железной дороге где-то вдалеке."
    nd_il "А уж когда закаты были, м-м-м..."
    us "И острова, на которых всегда есть вкусные ягодки!"
    nd_il "Да...{w} Славное было время."
    window hide

    play music ndm_list['soma_awake'] fadein 5
    $ renpy.pause(1, hard=True)

