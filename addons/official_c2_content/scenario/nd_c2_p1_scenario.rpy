label nd_c2_partOne:

    $ new_chapter(1, u"Фикционализм\nЧасть I - Розовые сны")
    $ nd_change_time('prolog')

    if config.developer == True:
        scene nd_developer_mode_alert with dissolve
        $ renpy.pause (60, hard=False)
        hide nd_developer_mode_alert 
        scene black
        with dissolve

    $ renpy.pause(2, hard=True)

    window show
    "Последние куски моего сознания были поглощены бескрайней пустотой того места, в которое я попал..."
    window hide

    $ renpy.pause(1, hard=True)
    show anim prolog_2 with dissolve2
    $ renpy.pause(1, hard=True)

    window show
    "Это была не «парящая» пустота, ведь я полностью ощущал ногами, как стою на очень ровной опоре."
    "Звуки превратились в раствор из кисло-сладких ощущений, прекратив покалывать мой слух и волшебным образом начиная ощущаться на языке."
    "С точки зрения биологии все было понятно – я сплю.{w} Но другой вопрос - сплю ли я за рулём нашего с Улей велосипеда или на своей кровати в домике, ожидая пробуждения в новом дне?.."
    "Ах…{w} Точно…{w} Того домика уже нет, как и моего прошлого."
    "Если это сон – то скоро вновь провал сознания, свидетельствующий о пробуждении."
    "Последнее, чего бы я сейчас хотел – оказаться в своих воспоминаниях…"
    window hide

    $ renpy.pause(1, hard=True)

    window show
    nd_whoer "Воспоминаниях…"
    "Вторило моё сознание, приготовившись построить картину, отличающуюся своей смазанностью и излишней нецелостностью..."
    window hide

    hide anim prolog_2
    scene black 
    with dissolve2
    $ renpy.pause(5, hard=True)

    $ nd_change_time('night')
    play ambience nda_list['ambience_int_apartaments_neutral'] fadein 4
    scene bg nd_c1_us_kitchen_glow with dissolve3
    stop music fadeout 10
    $ renpy.pause(3, hard=True)
    scene bg nd_c1_us_kitchen with dissolve3

    window show
    "Это была до боли знакомая мне советская квартира,{w} настолько знакомая, что я мог закрыть глаза и ещё раз представить себе её интерьер."
    "Спросите меня что находится в каждом углу комнаты - я с лёгкостью отвечу."
    "Сознание довольно запутанная штука. Ты можешь забыть о вещах до того момента, пока не окажешься в нужных условиях..."
    "Внешние ощущения вернулись ко мне – холод прошёлся по ногам, а в нос ударил запах ароматного мятного чая."
    "Я продолжал оценивать ситуацию..."
    window hide

    play sound nds_list['nd_cup_on_desk']
    $ renpy.pause(1, hard=True)
    show us normal sport at center with dspr

    window show
    usp "Ты будешь ещё чай?"
    "Только услышав знакомый мне голос, я, казалось, окончательно пришел в себя."
    "Перед моими глазами за столом сидела девочка, сильно похожая на мою любимую Ульяну."
    nd_il "Буду."
    "Коротко и вместе с тем неуверенно проговорил я, после чего занял более удобную позу на стуле."
    window hide

    show us smile sport at center with dspr
    $ renpy.pause(1, hard=True)
    hide us with dspr
    $ renpy.pause(1, hard=True)

    $ volume (0.2, "sound")
    play sound nds_list['nd_cup_tea_drop']
    
    window show
    "Ульяна встала из-за стола, взяла чайничек с уже заваренным чаем и добавила мне его в кружку."
    "Радостно припрыгнув, она вновь опустилась на свой стул, оставив меня наедине с чаем и…{w} с ней."
    "Поймав мой взгляд, она сначала насупилась, а потом смутилась, но смотреть на меня не перестала."
    "Просто любовалась тем, как я разглядываю узоры на кружке..."
    window hide

    $ renpy.pause(1, hard=True)
    show us shy sport at center with dspr
    play sound nds_list['nd_cup_tea_spoonswish']

    window show
    usp "Я рада, что ты ко мне пришёл. Моей мамы не будет до самого утра, поэтому я и пригласила тебя к себе."
    "Часы на стене показывали двенадцать пятнадцать."
    show us normal sport at center with dspr
    usp "Но уйти тебе придется раньше, чем настанет утро..."
    nd_il "Почему?"
    show us sad sport at center with dspr
    usp "Если мои родители узнают, что в нашей квартире был парень, ты сам знаешь, что будет…"
    usp "Они обещали прийти часам к десяти, но если внезапно заявятся раньше..."
    usp "Их слова нечасто находят подтверждение в реальных действиях, ты это уже знаешь, я рассказывала."
    window hide

    $ renpy.pause(1, hard=True)
    $ volume (1, "sound")

    window show
    "Я вдумчиво взглянул на неё, будто спрашивая взглядом, закончила ли она мысль.{w} Зря."
    play music ndm_list['mt_chun_blackbox']
    usp "…Отец опять меня изобьет, как в тот раз."
    th "Нет!"
    hide us with dspr
    "Я замолчал.{w} После сказанного девушкой, чай в горле показался комом, который никак не собирался проваливаться дальше."
    "Диалог превратился в гильотину а затем замер, затаился как лесной зверь, учуявший добычу, погрузив чащу в молчание перед преступлением."
    "Мой мозг заблокировал внутри себя что-то, что не позволило бы реплике Ульяны растаять в диалоге бесследно."
    "Возможно, это был страх, но смог бы он так сжимать грудь?"
    window hide

    $ renpy.pause(1, hard=True)
    show us normal sport at center with dspr

    window show
    nd_il "Давай убежим?"
    usp "Давай."
    "Сказала девушка без лишних раздумий."
    "Твёрдо и чётко."
    stop music fadeout 5
    usp "...но только давай сделаем это после фильма?"
    play sound sfx_inhale
    nd_il "Хорошо…"
    "Тяжело выдохнув, произнес я."
    "В этот момент я думал не совсем об Ульяне. Это были мысли скорее о моём прошлом."
    "А особенно - о событиях уходящего месяца, которые запомнятся мне ещё очень надолго."
    window hide

    $ renpy.pause(1, hard=True)
    hide us with dspr

    window show
    "Ульяна выпорхнула из-за стола, взяла меня за руку и потащила в комнату,{w} дав мне секунду на то, чтобы схватить кружку с теплым чаем."
    nd_il "Я ещё чай не допил."
    show us normal sport at left with dspr
    us "Допьёшь за фильмом."
    show us smile sport at left with dspr
    us "Пить чай за просмотром фильма, укутавшись в плед с девушкой куда приятнее вообще-то!"
    show us surp1 sport at left with dspr
    us "Бе-е-е."
    th "Я не смог сдержать улыбку."
    window hide

    stop ambience fadeout 3
    show black with nd_effect_5
    $ renpy.pause(2, hard=True)
    play ambience nda_list['ambience_int_something'] fadein 4
    scene bg nd_c1_us_bedroom with nd_effect_5 
    
    window show
    "Оказавшись в комнате, напоминавшей спальню советского подростка, я начал гулять по ней изучающим взглядом."
    "В него бросались рисунки над большой кроватью, маленький ламповый телевизор, магнитофон, куча кассет с фильмами на полках шкафов и художественная литература для учащихся девятого класса."
    "Ульяна запрыгнула на односпальную кровать, упала на подушку и укрылась пледом кремового цвета с замысловатым рисунком, по величине выглядевшим для неё достаточно большим."
    "Тем не менее, её ноги торчали из-под него, а голова пряталась, вероятно, от меня."
    nd_il "Уль, не лето всё-таки, а ты босиком ходишь."
    us "Да?{w=1} А мне не холодно…"
    window hide

    $ renpy.pause(1, hard=True)

    window show
    us "…Ну ладно, чуть-чуть может быть и холодно, но ты можешь исправить это."
    nd_il "Как?"
    us "Во тормоз... Объятиями, конечно!"
    "Поняв Ульяну, я сделал глоток немного сладкого чая направился к ней, но та тут же меня остановила."
    us "Стопэ, сначала телевизор включи и пульт возьми, а я кассету выберу…"
    "Командирские навыки у девушки всегда были на высоте."
    window hide

    $ renpy.pause(2, hard=True)
    play sound sfx_bed_squeak1
    play music ndm_list['cs_large_magellanic_cloud'] fadein 5
    $ renpy.pause(1, hard=True)

    window show
    "Выполнив все указания моей маленькой королевы, я получил в награду место под её пледом и нежные объятия, такие, какими могла меня наградить девочка её возраста."
    "Кассета в телевизоре при этом уже ждала своего часа."
    "Так как я не знал, что выбрала Ульяна на этот вечер, мне оставалось только строить догадки в голове."
    "Это точно не «терминатор», которого мы смотрели в прошлый раз, и точно не «последний герой»."
    "Что же это может быть?.."
    window hide

    $ renpy.pause(1, hard=True)
    show us grin sport close at left with dspr

    window show
    us "Сегодня мы с тобой смотрим-м-м…"
    th "Смотрим-м-м..."
    "Передразнил я девочку в уме."
    show us smile sport close at left with dspr
    us "…Розовые сны!"
    th "Что ещё за розовые сны?"
    nd_il "Хм… Такое я ещё не смотрел..."
    play sound nds_list['nd_cuptea_standed']
    "Вслух констатировал я, сделав заключительный глоток чая и поставив кружку рядом на стол."
    show us surp3 sport close at left with dspr
    us "Я тоже не смотрела..."
    "Сказала Ульяна, приобняв меня за руку, до этого момента спокойно лежавшую под одеялом."
    us "...поэтому и выбрала {i}такое{/i}."
    "Выделив интонацией слово \"такое\" она в своей манере передразнила меня, но в этот момент я не обратил на это внимания."
    window hide

    $ renpy.pause(1, hard=True)
    play sound sfx_inhale
    hide us with dspr

    window show
    nd_il "Ну тогда давай смотреть."
    "На выдохе произнес я, слишком сильно насладившись моментом и забыв про всё, что могло бы заботить меня."
    "Как я понял за те секунды, что мне были отведены дабы я взглянул на обложку кассеты{w} – это чехословацкая комедия в переводе на великий могучий."
    "Как по мне, комедии совсем не подходит такое название."
    "Хотя как я могу судить фильм лишь по его названию и началу?{w} Как-то предвзято с моей стороны..."
    window hide

    $ renpy.pause(1, hard=True)

    window show
    "Внутренний диалог внезапно остановился, позволив голосу за кадром озвучить название просматриваемого нами фильма."
    show us shy sport close at cleft with dspr
    "Ульяна,{w} сидящая слева от меня, решила полностью заключить меня в объятия и облокотиться, зная, что я смогу её удержать."
    "Причём она как-то предсказала, что при всем этом я не произнесу ни слова..."
    hide us with dspr
    "Как только закадровый голос перестал читать перевод с чехословацкого, Ульянка прикрыла свой ротик рукой и зевнула."
    th "Неужели уснёт в самом начале фильма?"
    window hide

    $ renpy.pause(1, hard=True)
    show us normal sport close at cleft with dspr

    window show
    us "Если я опять усну, разбуди меня, хорошо?"
    "Попросила она, переставая зевать и прикрывая глазки, примеряя меня сонным взглядом."
    nd_il "Хорошо, моя милая."
    hide us with dspr
    "Ещё секунда, и я целую её в румяную от смущения щёчку, поглаживая ладонью слегка влажные волосы."
    "Этот аромат земляники то ли от шеи, то ли от волос, прорывается в мои лёгкие, будто обволакивая их, успокаивая больше, чем любая сигарета."
    "Я чувствую, как Ульяна хочет поцеловать меня в мою щеку,{w} но промахивается и попадает в кончик моих губ."
    show us shy sport close at center with dspr
    us "Ой."
    hide us with dspr
    "Вот она уже тихо ойкает, стараясь скрыть смущение, а затем показательно отворачивается, словно обидевшись на свою неосторожность."
    us "Дурак…"
    "Тихо проговаривает она, оставляя на моём лице добрую улыбку, и только потом замечая её."
    window hide
    
    $ renpy.pause(1, hard=True)
    play sound sfx_inhale
    $ renpy.pause(1, hard=True)
    window show
    "Ульяна…{w} Неужели я так привязался к тебе?{w} И как я жил без тебя раньше?.."
    "Ну… До того, как ты забрала меня в свой Вондерленд, в свои «Розовые сны»..."
    "Зачем и главное почему?{w} Почему ты дала мне шанс стать кем-то, кто отдаст своё искалеченное сердце, кто позволит заполнить пустоту внутри себя?"
    "Кажется, ответ на этот вопрос лежит где-то, где обычно находится орган с аортой."
    window hide

    $ renpy.pause(1, hard=True)

    window show
    th "Вот это и случилось во второй раз."
    th "Я потерял своё внутреннее я, превратившись в тех, кого раньше презирал.{w} Но разве это плохо?"
    th "Чёрт возьми, я становлюсь как обычные люди, это уже огромное достижение!"
    th "Может старый я был не тем, кем на самом деле я являюсь?{w} Нет, я, конечно, понимаю, нужно сохранять холодную рассудительность, но иногда так хочется любить и быть любимым... "
    th "Наверное, за этот вечер я достаточно наигрался со словами, но скажу…"
    nd_il "Ульяна, каждая минута рядом с тобой для меня как розовый сон."
    window hide

    $ renpy.pause(1, hard=True)
    show us shy sport close at center with dspr
    stop music fadeout 4

    window show
    "Ульяна развернулась ко мне и смущенно посмотрела в мои глаза."
    us "Угу…{w=1} Я тоже тебя люблю…"
    window hide

    # - - - #
    $ renpy.pause(2, hard=True)
    stop music fadeout 4
    stop ambience fadeout 4
    scene black with dissolve3
    $ renpy.pause(4, hard=True)
    play music nd_c2_part1_start fadein 4
    scene nd_g_2_part_1_bg with dissolve3
    $ renpy.pause(1, hard=True)
    show nd_g_2_part_1_text with dissolve2
    $ renpy.pause(6, hard=True)
    stop music fadeout 4
    scene black with dissolve3 
    $ renpy.pause(3, hard=True)
    # - - - #

    jump nd_c2_partTwo